---
import ChatDiffere from '../components/ChatDiffere.astro';
import Consentement from '../components/Consentement.astro';
// Shell partagé du site (nav + fond + footer + design system).
// Utilisé par les pages qui doivent matcher l'accueil (blog, articles).
import '../styles/global.css';
import { GOOGLE_VERIFICATION, BING_VERIFICATION, SERVICES, SERVICES_EN } from '../data/entite.mjs';

// lang : 'fr' (défaut) ou 'en'. alt : chemin de la même page dans l'autre langue (hreflang + bouton FR | EN).
// minimal : page d'atterrissage sans issue (pas de menu, pas de pied à liens, logo non cliquable).
const { title, description, canonical, ogType = 'website', lang = 'fr', alt, minimal = false } = Astro.props;
const en = lang === 'en';
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://fournia.net';
const cta = en ? '/en/diagnostic/' : '/diagnostic/';
const L = en
  ? { services: 'Services', real: 'Our work', apropos: 'About', blog: 'Blog', cta: 'Book a call', menu: 'Open menu', accueil: '/en/',
      desc: 'We automate the repetitive tasks of Quebec small businesses. Based in Blainville, on Montreal\'s North Shore.',
      temoignages: 'Reviews', droits: '© 2026 FournIA. All rights reserved.', temoins: 'Manage cookies' }
  : { services: 'Services', real: 'Réalisations', apropos: 'À propos', blog: 'Blogue', cta: 'Réserver un appel', menu: 'Ouvrir le menu', accueil: '/',
      desc: 'On automatise les tâches répétitives des PME du Québec. Basé à Blainville, Rive-Nord de Montréal.',
      temoignages: 'Témoignages', droits: '© 2026 FournIA. Tous droits réservés.', temoins: 'Gérer les témoins' };
const cheminActuel = canonical ? canonical.replace(siteUrl, '') : null;
const altTrouve = alt ?? (cheminActuel ? cheminAutreLangue(cheminActuel) : null);
const autreLangue = altTrouve ?? (en ? '/' : '/en/');
const frPath = en ? altTrouve : cheminActuel;
const enPath = en ? cheminActuel : altTrouve;
// Monogramme officiel (references/brand/assets/fournia-monogram.svg, copié dans public/brand/).
const markSvg = '<img src="/brand/fournia-monogram.svg" alt="" width="40" height="40" />';
import Reseaux from '../components/Reseaux.astro';
import { autreLangue as cheminAutreLangue } from '../data/traductions.mjs';
---
<!doctype html>
<html lang={en ? "en-CA" : "fr-CA"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" type="image/svg+xml" href="/brand/fournia-favicon.svg" />
  <link rel="icon" type="image/png" href="/brand/fournia-icon-512.png" />
  <link rel="apple-touch-icon" href="/brand/fournia-icon-512.png" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {altTrouve && frPath && <link rel="alternate" hreflang="fr-CA" href={`${siteUrl}${frPath}`} />}
  {altTrouve && enPath && <link rel="alternate" hreflang="en-CA" href={`${siteUrl}${enPath}`} />}
  {altTrouve && frPath && <link rel="alternate" hreflang="x-default" href={`${siteUrl}${frPath}`} />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:locale" content={en ? "en_CA" : "fr_CA"} />
  <meta property="og:site_name" content="FournIA" />
  <meta property="og:image" content="https://fournia.net/brand/fournia-lockup-horizontal-dark.png" />
  {GOOGLE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />}
  {BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&family=Inter:wght@300;400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&family=Inter:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&family=Inter:wght@300;400;500;600&display=swap" /></noscript>
  <slot name="head" />
</head>
<body>
  <div class="bg-fx">
    <div class="grid-lines"></div>
    <div class="glow glow-1"></div>
    <div class="grain"></div>
  </div>

  {minimal ? (
    <nav id="nav" class="nav-minimal">
      <div class="nav-inner">
        <span class="logo" aria-label="FournIA"><span class="mark" set:html={markSvg}></span><span>Fourn<span class="ia">IA</span></span></span>
      </div>
    </nav>
  ) : (
    <nav id="nav">
      <div class="nav-inner">
        <a href={L.accueil} class="logo" aria-label="FournIA"><span class="mark" set:html={markSvg}></span><span>Fourn<span class="ia">IA</span></span></a>
        <ul class="nav-links">
          <li><a href={`${L.accueil}#services`}>{L.services}</a></li>
          <li><a href={`${L.accueil}#exemples`}>{L.real}</a></li>
          <li><a href={en ? '/en/about/' : '/a-propos/'}>{L.apropos}</a></li>
          <li><a href={en ? '/en/blog/' : '/blog/'}>{L.blog}</a></li>
          <li><a href={autreLangue} class="lien-langue" lang={en ? 'fr' : 'en'} hreflang={en ? 'fr-CA' : 'en-CA'} aria-label={en ? 'Version française' : 'English version'}>{en ? 'FR' : 'EN'}</a></li>
        </ul>
        <a href={cta} class="btn btn-primary cta-nav">{L.cta} <span class="arrow">→</span></a>
        <button type="button" class="hamburger" id="burger" aria-label={L.menu} aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </nav>
  )}

  <slot />

  {minimal ? (
    <footer class="foot-minimal">
      <div class="wrap foot-bottom">{L.droits} · <a href={en ? "/en/privacy/" : "/confidentialite/"}>{en ? "Privacy policy" : "Politique de confidentialité"}</a> · <a href="#" onclick="window.fourniaTemoins&&fourniaTemoins();return false">{L.temoins}</a></div>
    </footer>
  ) : (
    <footer>
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a href={L.accueil} class="logo" style="font-size:1.5rem"><span class="mark" set:html={markSvg}></span><span>Fourn<span class="ia">IA</span></span></a>
            <p style="color:var(--mute); margin-top:1rem; max-width:280px; font-size:.92rem;">{L.desc}</p>
            <Reseaux lang={lang} />
          </div>
          <div class="foot-contact">
            <a href="mailto:s.fournier@fournia.net">s.fournier@fournia.net</a>
            <a href="tel:+15148632973">514 863 2973</a>
            <a href="/">fournia.net</a>
          </div>
          <div class="foot-contact">
            {en ? (
              <Fragment>
                <a href="/en/about/">{L.apropos}</a>
                <a href="/en/testimonials/">{L.temoignages}</a>
                {SERVICES_EN.map((sv) => <a href={sv.href}>{sv.label}</a>)}
                <a href="/en/blog/">{L.blog}</a>
                <a href={cta}>{L.cta}</a>
              </Fragment>
            ) : (
              <Fragment>
                <a href="/a-propos/">À propos</a>
                <a href="/temoignages/">Témoignages</a>
                {SERVICES.map((sv) => <a href={sv.href}>{sv.label}</a>)}
                <a href="/#processus">Processus</a>
                <a href="/blog">Blogue</a>
                <a href={cta}>Réserver un appel</a>
              </Fragment>
            )}
          </div>
        </div>
        <div class="foot-bottom">{L.droits} · <a href="#" onclick="window.fourniaTemoins&&fourniaTemoins();return false">{L.temoins}</a></div>
      </div>
    </footer>
  )}

  <script is:inline>
    const nav = document.getElementById('nav');
    addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 30));
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: .15 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    addEventListener('load', () => document.querySelectorAll('main .reveal').forEach(el => el.classList.add('in')));
    const burger = document.getElementById('burger');
    if (burger) burger.addEventListener('click', (e) => { e.stopPropagation(); const o = nav.classList.toggle('open'); burger.setAttribute('aria-expanded', o); });
    document.querySelectorAll('.nav-links a').forEach(a => a.addEventListener('click', () => nav.classList.remove('open')));
    document.addEventListener('click', (e) => { if (!nav.contains(e.target)) nav.classList.remove('open'); });
  </script>
  <!-- Bulle de clavardage SaaS AI System : les messages arrivent dans la boite unifiee du CRM. -->
  {!minimal && <ChatDiffere />}
  <Consentement lang={lang} />
</body>
</html>
