---
// Gabarit des pages de service (pages commerciales qui ciblent une requête précise).
// Émet au build : WebPage + Service + FAQPage + BreadcrumbList, reliés à l'entité FournIA (#fournia).
import Base from './Base.astro';
import Temoignages from '../components/Temoignages.astro';
import { SITE, CTA, SERVICES } from '../data/entite.mjs';

// `essentiel` (optionnel) : 3 ou 4 points { t, d } affichés sous le bouton, pour comprendre la page en 5 secondes.
const { path, title, description, h1, lead, serviceName, serviceType, areaServed, faq = [], updated, essentiel = [], image, imageAlt = '' } = Astro.props;
const canonical = `${SITE}${path}/`;

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'fr-CA',
  isPartOf: { '@type': 'WebSite', '@id': `${SITE}/#site`, url: `${SITE}/`, name: 'FournIA' },
  about: { '@id': `${SITE}/#fournia` },
  ...(updated ? { dateModified: updated } : {}),
};
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType,
  description,
  url: canonical,
  provider: { '@id': `${SITE}/#fournia` },
  areaServed: (areaServed ?? ['Québec']).map((name) => ({ '@type': 'Place', name })),
  inLanguage: 'fr-CA',
};
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: serviceName, item: canonical },
  ],
};
const autres = SERVICES.filter((s) => s.href.replace(/\/$/, '') !== path);
---
<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webPageLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
  {faqLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <main>
    <article class="svc">
      <div class="wrap-narrow">
        <!-- Haut de page sans `reveal` : visible dès le premier rendu (LCP). -->
        <div class="crumbs"><a href="/">Accueil</a> <span>/</span> {serviceName}</div>
        <h1>{h1}</h1>
        <p class="lead">{lead}</p>
        <a class="btn btn-primary" href={CTA}>Réserver un appel découverte gratuit <span class="arrow">→</span></a>

        {essentiel.length > 0 && (
          <dl class="essentiel">
            {essentiel.map((e) => (
              <div><dt>{e.t}</dt><dd>{e.d}</dd></div>
            ))}
          </dl>
        )}

        {image && (
          <figure class="svc-visuel"><img src={image} alt={imageAlt} width="1200" height="800" loading="eager" decoding="async" /></figure>
        )}
        <div class="prose"><slot /></div>

        <Temoignages />

        {faq.length > 0 && (
          <section class="faq">
            <h2>Questions fréquentes</h2>
            {faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <div class="post-cta">
          <h3>Un processus manuel vous coûte du temps ?</h3>
          <p>Un appel découverte gratuit de 30 minutes pour voir si l'IA peut vous aider. Sans engagement.</p>
          <a class="btn btn-primary" href={CTA}>Réserver un appel <span class="arrow">→</span></a>
        </div>

        <div class="autres">
          <span>Voir aussi :</span>
          {autres.map((s) => <a href={s.href}>{s.label}</a>)}
          <a href="/blog">Le blogue</a>
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  main { position: relative; z-index: 1; }
  .svc { padding: 8.5rem 0 4rem; }
  .wrap-narrow { width: min(760px, 92vw); margin: 0 auto; }
  .crumbs { font-size: .85rem; color: var(--mute); margin-bottom: 1.4rem; }
  .crumbs a:hover { color: var(--lime); }
  .crumbs span { margin: 0 .4rem; }
  .svc h1 { text-wrap: balance; font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.08; letter-spacing: -.02em; font-weight: 700; margin-bottom: 1.2rem; }
  .lead { color: var(--mute); font-size: 1.15rem; line-height: 1.7; margin-bottom: 1.8rem; }

  .svc-visuel { margin: 2.6rem 0 0; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 3 / 2; }
  .svc-visuel img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .essentiel { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin: 2.4rem 0 0; border: 1px solid var(--glass-b); border-radius: 18px; overflow: hidden; background: rgba(18,18,18,.6); }
  .essentiel > div { padding: 1.2rem 1.3rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; }
  .essentiel dt { color: var(--lime); font-size: .85rem; font-weight: 500; margin-bottom: .3rem; }
  .essentiel dd { color: var(--white); font-size: .98rem; line-height: 1.45; margin: 0; }

  .prose { color: var(--mute); font-size: 1.06rem; line-height: 1.75; margin-top: 3rem; }
  /* Blocs (paliers, formats, étapes) : remplacent les tableaux et les longs paragraphes. */
  .prose :global(.blocs) { list-style: none; margin: 1.4rem 0 1.6rem; padding: 0; display: grid; gap: .8rem; }
  .prose :global(.blocs > li) { margin: 0; padding: 1.2rem 1.4rem; border: 1px solid var(--line); border-radius: 16px; background: var(--glass); }
  .prose :global(.blocs strong) { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.12rem; margin-bottom: .25rem; }
  .prose :global(.blocs p) { margin: 0; font-size: 1rem; line-height: 1.6; }
  .prose :global(ol.etapes) { list-style: none; margin: 1.2rem 0 1.4rem; padding: 0; counter-reset: etape; }
  .prose :global(ol.etapes > li) { counter-increment: etape; position: relative; padding: 0 0 1rem 2.6rem; margin: 0; }
  .prose :global(ol.etapes > li::before) { content: counter(etape); position: absolute; left: 0; top: .1rem; width: 1.75rem; height: 1.75rem; border-radius: 50%; border: 1px solid rgba(183,217,76,.45); color: var(--lime); font-family: 'Space Grotesk', sans-serif; font-size: .85rem; font-weight: 600; display: grid; place-items: center; }
  .prose :global(.note) { font-size: .95rem; color: var(--mute); border-top: 1px solid var(--line); padding-top: 1rem; }
  .prose :global(h2) { font-family: 'Space Grotesk', sans-serif; color: var(--white); font-size: 1.7rem; line-height: 1.2; letter-spacing: -.01em; margin: 2.6rem 0 1rem; }
  .prose :global(h3) { font-family: 'Space Grotesk', sans-serif; color: var(--white); font-size: 1.3rem; margin: 2rem 0 .8rem; }
  .prose :global(p) { margin-bottom: 1.2rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2rem 1.3rem; }
  .prose :global(li) { margin-bottom: .5rem; }
  .prose :global(a) { color: var(--lime); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: rgba(183,217,76,.4); }
  .prose :global(strong) { color: var(--white); font-weight: 600; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.6rem 0; font-size: .95rem; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--line); padding: .7rem .9rem; text-align: left; vertical-align: top; }
  .prose :global(th) { color: var(--white); background: var(--glass); }

  .faq { margin-top: 3rem; }
  .faq h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.7rem; margin-bottom: 1.2rem; }
  .faq details { border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.2rem; margin-bottom: .8rem; background: var(--glass); }
  .faq summary { cursor: pointer; color: var(--white); font-weight: 500; }
  .faq details p { color: var(--mute); margin-top: .8rem; line-height: 1.7; }

  .post-cta { margin-top: 3.5rem; padding: 2.2rem; border-radius: 22px;
    background: linear-gradient(160deg, rgba(183,217,76,.10), rgba(20,20,20,.55)); border: 1px solid var(--glass-b); }
  .post-cta h3 { font-size: 1.4rem; margin-bottom: .6rem; color: var(--white); }
  .post-cta p { color: var(--mute); margin-bottom: 1.4rem; }

  .autres { margin-top: 2.4rem; display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; font-size: .92rem; color: var(--mute); }
  .autres a { color: var(--lime); }
</style>
