---
// Comparaison visuelle « sans / avec le système » de la landing : un téléphone joue la scène, comme la démo de
// l'accueil (src/components/Accueil.astro), au « tu ». CSS préfixé .demo-lp (aucune collision avec la page).
// Scènes types, aucun client réel. Les trois correspondent à ce que des systèmes livrés font déjà
// (relances, soumissions, réponse aux demandes). Pas d'agent vocal ni d'appel manqué (aucun système livré ne le prouve).
const SCENARIOS = [
  { id: 'relances', titre: 'Les relances', pour: 'Soumissions sans réponse', contact: 'M. Tremblay', canal: 'Texto',
    avant: "Ta soumission est partie il y a cinq jours. Personne n'a fait de suivi, et le client signe ailleurs.",
    etapes: [
      { quand: 'Jour 3', quoi: 'Le système lui écrit un texto poli, à ton nom.' },
      { quand: 'Jour 3, 16 h', quoi: 'Il répond : « On en reparle mardi ? »' },
      { quand: 'Aussitôt', quoi: 'La réponse est notée au dossier, avec la date où reprendre.' },
    ],
    sans: [
      { who: 'out', t: 'Lundi', txt: 'Bonjour M. Tremblay, voici votre soumission pour les travaux.' },
      { who: 'sys', t: '5 jours plus tard', txt: "Aucune réponse. Personne ne l'a relancé." },
      { who: 'perte', t: '', txt: 'Le client a signé ailleurs.' },
    ],
    avec: [
      { who: 'out', t: 'Lundi', txt: 'Bonjour M. Tremblay, voici votre soumission pour les travaux.' },
      { who: 'sys', t: 'Jour 3, 9 h', txt: 'Pas de réponse : relance automatique', step: 0 },
      { who: 'out', t: 'Jour 3, 9 h', txt: 'Bonjour M. Tremblay, avez-vous eu le temps de regarder la soumission ? Je peux répondre à vos questions.' },
      { who: 'in', t: 'Jour 3, 16 h', txt: 'Oui ! On en reparle mardi ?', step: 1 },
      { who: 'sys', t: 'Aussitôt', txt: 'Noté au dossier · À reprendre mardi', step: 2 },
    ],
    resultat: 'Tu reprends la conversation au bon moment, sans rien avoir à retenir.' },
  { id: 'soumissions', titre: 'Les soumissions', pour: 'Demandes à chiffrer', contact: 'Formulaire du site', canal: 'Demande',
    avant: 'Chaque demande prend une heure à chiffrer et à mettre en page, souvent le soir.',
    etapes: [
      { quand: 'La demande arrive', quoi: 'Le système lit la demande : date, nombre de personnes, options.' },
      { quand: 'Quelques minutes après', quoi: 'Il calcule le prix selon ta grille.' },
      { quand: 'Ensuite', quoi: "Un brouillon à ton image t'attend. Tu valides." },
    ],
    sans: [
      { who: 'in', t: '19 h 40', txt: "Bonjour, j'aurais besoin d'un prix pour 120 personnes le 12 décembre." },
      { who: 'sys', t: 'Le soir même', txt: 'Tu chiffres et tu mets en page à la main.' },
      { who: 'perte', t: '', txt: 'Une soirée de plus sur la paperasse.' },
    ],
    avec: [
      { who: 'in', t: '19 h 40', txt: "Bonjour, j'aurais besoin d'un prix pour 120 personnes le 12 décembre." },
      { who: 'sys', t: '19 h 44', txt: 'Demande lue · 120 personnes · 12 décembre', step: 0 },
      { who: 'sys', t: '19 h 44', txt: 'Prix calculé selon ta grille', step: 1 },
      { who: 'sys', t: '19 h 45', txt: 'Brouillon prêt · En attente de ta validation', step: 2 },
      { who: 'out', t: '19 h 50', txt: 'Bonjour ! Voici votre soumission pour le 12 décembre. Au plaisir.' },
    ],
    resultat: 'Tu relis, tu ajustes au besoin, tu envoies.' },
  { id: 'demandes', titre: 'Les nouvelles demandes', pour: 'Pendant que tu es occupé', contact: 'Nouvelle demande', canal: 'Messenger',
    avant: "Une demande arrive pendant que tu es avec un client. Elle attend jusqu'au soir, et la personne a déjà écrit à quelqu'un d'autre.",
    etapes: [
      { quand: '14 h 12', quoi: 'Une demande arrive pendant que tu es occupé.' },
      { quand: 'Quelques minutes après', quoi: 'Le système répond à ton nom, avec les bonnes questions.' },
      { quand: 'Ensuite', quoi: 'La demande est classée au dossier. Tu reprends la suite.' },
    ],
    sans: [
      { who: 'in', t: '14 h 12', txt: 'Bonjour, êtes-vous disponibles le 12 décembre pour 80 personnes ?' },
      { who: 'sys', t: '21 h', txt: 'Toujours sans réponse.' },
      { who: 'perte', t: '', txt: 'La personne a réservé ailleurs.' },
    ],
    avec: [
      { who: 'in', t: '14 h 12', txt: 'Bonjour, êtes-vous disponibles le 12 décembre pour 80 personnes ?', step: 0 },
      { who: 'out', t: '14 h 16', txt: 'Bonjour ! Merci pour votre message. On regarde ça. Pour quelles heures, et à quelle adresse ?', step: 1 },
      { who: 'in', t: '14 h 20', txt: 'De 18 h à 23 h, à Laval.' },
      { who: 'sys', t: '14 h 20', txt: 'Classée au dossier · À reprendre par toi', step: 2 },
    ],
    resultat: 'Chaque nouvelle demande reçoit une réponse, même quand tu es occupé.' },
];
const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<div class="demo-lp" data-demo-lp data-mode="avec">
  <div class="onglets" role="tablist" aria-label="Choisir une tâche">
    {SCENARIOS.map((sc, i) => (
      <button type="button" role="tab" id={`lp-tab-${sc.id}`} aria-controls={`lp-pan-${sc.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="num">0{i + 1}</span>
        <span class="nom">{sc.titre}</span>
        <span class="pour">{sc.pour}</span>
      </button>
    ))}
  </div>
  <div class="scene">
    <div class="scene-barre">
      <div class="bascule" role="group" aria-label="Comparer sans et avec le système">
        <button type="button" data-mode="sans" aria-pressed="false">Sans le système</button>
        <button type="button" data-mode="avec" aria-pressed="true">Avec le système</button>
        <span class="curseur" aria-hidden="true"></span>
      </div>
      <button type="button" class="rejouer" data-rejouer><span aria-hidden="true">↻</span> Rejouer</button>
    </div>
    <div class="scene-corps">
      <div class="tel">
        <div class="tel-tete">
          <span class="avatar" aria-hidden="true" data-initiale></span>
          <div><strong data-contact>{SCENARIOS[0].contact}</strong><span data-canal>{SCENARIOS[0].canal}</span></div>
        </div>
        <div class="tel-fil" data-fil aria-live="polite"></div>
        <div class="tel-progres" aria-hidden="true"><span data-progres></span></div>
      </div>
      <div class="journal">
        {SCENARIOS.map((sc, i) => (
          <div class="panneau" role="tabpanel" id={`lp-pan-${sc.id}`} aria-labelledby={`lp-tab-${sc.id}`} hidden={i !== 0}>
            <div class="j-sans">
              <p class="lbl">Aujourd'hui</p>
              <p class="avant-txt">{sc.avant}</p>
            </div>
            <div class="j-avec">
              <p class="lbl">Avec le système</p>
              <ol>
                {sc.etapes.map((e, k) => (
                  <li data-step={k}><span class="quand">{e.quand}</span><span class="quoi">{e.quoi}</span></li>
                ))}
              </ol>
              <p class="resultat" set:html={check + `<span>${sc.resultat}</span>`}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <script type="application/json" data-demo-donnees set:html={JSON.stringify(SCENARIOS)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-demo-lp]').forEach((demo) => {
    const DATA = JSON.parse(demo.querySelector('[data-demo-donnees]')!.textContent || '[]');
    const tabs = [...demo.querySelectorAll<HTMLElement>('[role=tab]')];
    const fil = demo.querySelector<HTMLElement>('[data-fil]')!;
    const prog = demo.querySelector<HTMLElement>('[data-progres]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, mode = 'avec', timers: number[] = [], auto = true, vu = false;
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const esc = (t: string) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as Record<string, string>)[c]);
    const add = (html: string) => { fil.insertAdjacentHTML('beforeend', html); fil.scrollTop = fil.scrollHeight; };
    function play() {
      clear();
      const sc = DATA[idx]; const evs = sc[mode];
      demo.dataset.mode = mode;
      demo.querySelectorAll<HTMLElement>('.bascule button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      demo.querySelector('[data-contact]')!.textContent = sc.contact;
      demo.querySelector('[data-canal]')!.textContent = sc.canal;
      demo.querySelector('[data-initiale]')!.textContent = sc.contact.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').charAt(0);
      const pan = demo.querySelector<HTMLElement>('#lp-pan-' + sc.id)!;
      pan.querySelectorAll('li').forEach((li) => li.classList.remove('on'));
      const res = pan.querySelector('.resultat')!; res.classList.remove('vu');
      fil.innerHTML = ''; prog.style.width = '0%';
      const tab = tabs[idx]; tab.style.setProperty('--avance', '0%');
      let t = 300;
      evs.forEach((e: any, k: number) => {
        const typing = (e.who === 'in' || e.who === 'out') && !reduce;
        if (typing) { later(() => add(`<span class="ecrit ${e.who}" data-tmp><i></i><i></i><i></i></span>`), t); t += 900; }
        later(() => {
          fil.querySelector('[data-tmp]')?.remove();
          if (e.who === 'in' || e.who === 'out') add(`<p class="bulle ${e.who}">${esc(e.txt)}<span class="h">${esc(e.t)}</span></p>`);
          else if (e.who === 'perte') add(`<p class="puce perte">${esc(e.txt)}</p>`);
          else add(`<p class="puce">${e.t ? `<b>${esc(e.t)}</b> · ` : ''}${esc(e.txt)}</p>`);
          if (e.step !== undefined) pan.querySelector(`li[data-step="${e.step}"]`)?.classList.add('on');
          const pct = Math.round(((k + 1) / evs.length) * 100) + '%';
          prog.style.width = pct; tab.style.setProperty('--avance', pct);
        }, t);
        t += reduce ? 0 : 1100;
      });
      later(() => {
        if (mode === 'avec') { res.classList.add('vu'); pan.querySelectorAll('li').forEach((li) => li.classList.add('on')); }
        if (auto) later(() => { if (mode === 'sans') { mode = 'avec'; play(); } else { select((idx + 1) % tabs.length); } }, 2600);
      }, t);
    }
    function select(i: number) {
      idx = i;
      tabs.forEach((x, j) => { const on = j === i; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
        (demo.querySelector('#' + x.getAttribute('aria-controls')) as HTMLElement).hidden = !on; x.style.setProperty('--avance', '0%'); });
      mode = auto ? 'sans' : mode;
      play();
    }
    const stopAuto = () => { auto = false; };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stopAuto(); mode = 'avec'; select(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault(); stopAuto(); const n = (i + d + tabs.length) % tabs.length; tabs[n].focus(); mode = 'avec'; select(n);
      });
    });
    demo.querySelectorAll<HTMLElement>('.bascule button').forEach((b) => b.addEventListener('click', () => { stopAuto(); mode = b.dataset.mode || 'avec'; play(); }));
    demo.querySelector('[data-rejouer]')!.addEventListener('click', () => { stopAuto(); play(); });
    new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting && !vu) { vu = true; mode = reduce ? 'avec' : 'sans'; if (reduce) auto = false; select(0); }
      else if (!e.isIntersecting && vu) { stopAuto(); }
    }), { threshold: .35 }).observe(demo);
  });
</script>

<style is:global>
  .demo-lp { display: grid; grid-template-columns: 290px 1fr; border: 1px solid var(--glass-b); border-radius: 26px; overflow: hidden;
    background: linear-gradient(170deg, rgba(22,23,21,.9), rgba(12,12,12,.9)); }
  .demo-lp .onglets { display: flex; flex-direction: column; border-right: 1px solid var(--line); }
  .demo-lp .onglets button { all: unset; box-sizing: border-box; cursor: pointer; display: grid; grid-template-columns: 2.2rem 1fr; column-gap: .3rem;
    padding: 1.5rem 1.5rem; border-bottom: 1px solid var(--line); transition: background .25s; position: relative; }
  .demo-lp .onglets button:hover { background: rgba(255,255,255,.03); }
  .demo-lp .onglets button[aria-selected=true] { background: rgba(183,217,76,.07); }
  .demo-lp .onglets button[aria-selected=true]::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--lime); }
  .demo-lp .onglets button[aria-selected=true]::after { content: ''; position: absolute; left: 0; bottom: 0; height: 2px; width: var(--avance, 0%); background: rgba(183,217,76,.6); transition: width .3s linear; }
  .demo-lp .onglets button:focus-visible { outline: 2px solid var(--lime); outline-offset: -2px; }
  .demo-lp .onglets .num { grid-row: 1 / 3; color: var(--mute-d); font-family: 'Space Grotesk', sans-serif; font-size: .9rem; padding-top: .15rem; }
  .demo-lp .onglets [aria-selected=true] .num { color: var(--lime); }
  .demo-lp .onglets .nom { font-family: 'Space Grotesk', 'Space Grotesk Repli', sans-serif; font-size: 1.1rem; font-weight: 500; color: var(--white); }
  .demo-lp .onglets .pour { color: var(--mute); font-size: .85rem; }

  .demo-lp .scene { padding: 1.6rem 2rem 2rem; }
  .demo-lp .scene-barre { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.6rem; flex-wrap: wrap; }
  .demo-lp .bascule { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 100px; background: rgba(255,255,255,.05); border: 1px solid var(--glass-b); }
  .demo-lp .bascule button { all: unset; cursor: pointer; position: relative; z-index: 1; padding: .55rem 1.1rem; font-size: .9rem; font-weight: 500; text-align: center; color: var(--mute); transition: color .3s; border-radius: 100px; }
  .demo-lp .bascule button[aria-pressed=true] { color: #0b0b0c; }
  .demo-lp .bascule button:focus-visible { outline: 2px solid var(--lime); }
  .demo-lp .curseur { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 100px; background: var(--lime); transition: transform .45s cubic-bezier(.2,.8,.3,1), background .3s; }
  .demo-lp[data-mode=avec] .curseur { transform: translateX(100%); }
  .demo-lp[data-mode=sans] .curseur { background: #e9e9e4; }
  .demo-lp .rejouer { all: unset; cursor: pointer; color: var(--mute); font-size: .9rem; padding: .5rem .9rem; border-radius: 100px; border: 1px solid var(--glass-b); transition: color .2s, border-color .2s; }
  .demo-lp .rejouer:hover, .demo-lp .rejouer:focus-visible { color: var(--lime); border-color: rgba(183,217,76,.5); }

  .demo-lp .scene-corps { display: grid; grid-template-columns: 340px 1fr; gap: 2.6rem; align-items: start; }
  .demo-lp .tel { border-radius: 34px; padding: 10px; background: #050505; border: 1px solid rgba(255,255,255,.12); box-shadow: 0 30px 70px rgba(0,0,0,.5), inset 0 0 0 1px rgba(255,255,255,.03); }
  .demo-lp .tel-tete { display: flex; align-items: center; gap: .7rem; padding: .9rem 1rem; border-radius: 26px 26px 0 0; background: #141414; border-bottom: 1px solid var(--line); }
  .demo-lp .tel-tete .avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: #2a2b28; color: var(--white); font-family: 'Space Grotesk', sans-serif; font-size: .9rem; }
  .demo-lp .tel-tete strong { display: block; font-size: .95rem; font-weight: 600; }
  .demo-lp .tel-tete span { color: var(--mute); font-size: .78rem; }
  .demo-lp .tel-fil { height: 390px; overflow-y: auto; padding: 1rem .9rem; background: #0d0d0e; display: flex; flex-direction: column; gap: .55rem; scroll-behavior: smooth; scrollbar-width: none; }
  .demo-lp .tel-fil::-webkit-scrollbar { display: none; }
  .demo-lp .tel-progres { height: 3px; background: #141414; border-radius: 0 0 26px 26px; overflow: hidden; }
  .demo-lp .tel-progres span { display: block; height: 100%; width: 0; background: var(--lime); transition: width .4s ease; }
  .demo-lp[data-mode=sans] .tel-progres span { background: #e5484d; }
  .demo-lp .bulle { max-width: 82%; padding: .6rem .85rem; border-radius: 18px; font-size: .88rem; line-height: 1.4; animation: pop .35s cubic-bezier(.2,.8,.3,1) both; }
  .demo-lp .bulle .qui { display: block; font-size: .68rem; font-weight: 600; letter-spacing: .02em; opacity: .7; margin-bottom: .15rem; }
  .demo-lp .tel.appel .tel-tete span:not(.avatar) { color: var(--lime); }
  .demo-lp .tel.appel .tel-tete span:not(.avatar)::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); margin-right: .4rem; animation: point 1.2s infinite; }
  .demo-lp .bulle .h { display: block; font-size: .68rem; opacity: .6; margin-top: .25rem; }
  .demo-lp .bulle.out { align-self: flex-end; background: var(--lime); color: #0b0b0c; border-bottom-right-radius: 6px; }
  .demo-lp .bulle.in { align-self: flex-start; background: #262725; color: var(--white); border-bottom-left-radius: 6px; }
  .demo-lp .puce { align-self: center; text-align: center; font-size: .76rem; color: var(--mute); padding: .4rem .8rem; border-radius: 100px; border: 1px solid var(--glass-b); background: rgba(255,255,255,.03); animation: pop .35s ease both; max-width: 92%; }
  .demo-lp .puce b { color: var(--lime); font-weight: 500; }
  .demo-lp .puce.perte { color: #ffb4b0; border-color: rgba(229,72,77,.45); background: rgba(229,72,77,.1); font-size: .84rem; padding: .6rem .9rem; border-radius: 14px; }
  .demo-lp .ecrit { align-self: flex-start; display: inline-flex; gap: 4px; padding: .7rem .85rem; border-radius: 18px; background: #262725; }
  .demo-lp .ecrit.out { align-self: flex-end; background: rgba(183,217,76,.35); }
  .demo-lp .ecrit i { width: 6px; height: 6px; border-radius: 50%; background: var(--white); opacity: .5; animation: point 1s infinite; }
  .demo-lp .ecrit i:nth-child(2) { animation-delay: .15s; } .ecrit i:nth-child(3) { animation-delay: .3s; }
  @keyframes point { 0%, 60%, 100% { transform: translateY(0); opacity: .35; } 30% { transform: translateY(-3px); opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.97); } to { opacity: 1; transform: none; } }

  .demo-lp .panneau[hidden] { display: none; }
  .demo-lp .lbl { font-size: .82rem; color: var(--mute); margin-bottom: 1rem; font-weight: 500; }
  .demo-lp[data-mode=avec] .j-sans, .demo-lp[data-mode=sans] .j-avec { display: none; }
  .demo-lp .avant-txt { color: #d6d8d1; font-size: 1.15rem; line-height: 1.65; padding: 1.4rem; border-radius: 16px; border: 1px dashed rgba(229,72,77,.35); background: rgba(229,72,77,.05); }
  .demo-lp .j-avec ol { list-style: none; position: relative; margin-bottom: 1.4rem; }
  .demo-lp .j-avec ol::before { content: ''; position: absolute; left: 6px; top: .6rem; bottom: 1.6rem; width: 1px; background: rgba(255,255,255,.12); }
  .demo-lp .j-avec li { position: relative; padding: 0 0 1.4rem 2rem; display: flex; flex-direction: column; gap: .2rem; opacity: .35; transition: opacity .4s; }
  .demo-lp .j-avec li::before { content: ''; position: absolute; left: 0; top: .4rem; width: 13px; height: 13px; border-radius: 50%; background: var(--ink-950); border: 2px solid rgba(255,255,255,.3); transition: all .4s; }
  .demo-lp .j-avec li.on { opacity: 1; }
  .demo-lp .j-avec li.on::before { background: var(--lime); border-color: var(--lime); box-shadow: 0 0 0 5px rgba(183,217,76,.15); }
  .demo-lp .j-avec .quand { color: var(--lime); font-size: .84rem; font-family: 'Space Grotesk', sans-serif; }
  .demo-lp .j-avec .quoi { color: var(--white); font-size: 1.04rem; line-height: 1.5; }
  .demo-lp .resultat { display: flex; gap: .7rem; align-items: start; padding: 1.1rem 1.2rem; border-radius: 14px; background: rgba(183,217,76,.1); color: var(--white); font-weight: 500;
    opacity: 0; transform: translateY(8px); transition: opacity .5s, transform .5s; }
  @media (max-width: 960px) {
    .demo-lp { grid-template-columns: 1fr; }
    .demo-lp .onglets { flex-direction: row; overflow-x: auto; border-right: none; border-bottom: 1px solid var(--line); scrollbar-width: none; }
    .demo-lp .onglets button { flex: none; display: block; padding: 1rem 1.2rem; border-bottom: none; border-right: 1px solid var(--line); white-space: nowrap; }
    .demo-lp .onglets .num, .demo-lp .onglets .pour { display: none; }
    .demo-lp .onglets .nom { font-size: 1rem; }
    .demo-lp .onglets button[aria-selected=true]::before { top: auto; width: auto; right: 0; height: 3px; }
    .demo-lp .scene { padding: 1.2rem; }
    .demo-lp .scene-corps { grid-template-columns: 1fr; gap: 1.6rem; }
    .demo-lp .tel { max-width: 380px; width: 100%; margin: 0 auto; }
    .demo-lp .tel-fil { height: 340px; }
  }
  @media (max-width: 560px) {
    .demo-lp { border-radius: 20px; }
    .demo-lp .scene { padding: 1rem; }
    .demo-lp .bascule button { padding: .5rem .8rem; font-size: .82rem; }
    .demo-lp .rejouer { display: none; }
    .demo-lp .tel-fil { height: 300px; }
    .demo-lp .avant-txt { font-size: 1rem; }
  }
</style>
