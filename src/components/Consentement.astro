---
// Bandeau de consentement aux témoins (Loi 25, art. 8.1) : les outils de mesure et de publicité
// (script de suivi du CRM, pixel Meta, Google Analytics G-HFPYMCE8Y9) restent désactivés tant que le
// visiteur n'a pas accepté. Événements GA4 (seulement après le « oui », jamais de nom ni de courriel) :
// clic_reserver, rdv_calendly, diagnostic_commence, diagnostic_envoye, clic_telephone, clic_courriel,
// clic_cta, chat_ouvert, faq_ouverte, defilement, lecture_article, temps_engage, section_vue,
// consentement_accepte. Le reste (pages vues, sources, liens sortants, recherche) = mesure améliorée GA4.
// La bulle de clavardage n'en dépend pas : c'est un service que le visiteur choisit d'utiliser.
// Rouvrir le bandeau : window.fourniaTemoins() (lien « Gérer les témoins » du pied de page).
// Pixel Meta, défini pour TOUTES les pages (accueil, services, blog, secteurs, diagnostic). Il ne se
// charge qu'après le « oui » : activer() appelle window.__fourniaPixel. Si une page le définit déjà
// (diagnostic), on garde le sien. Artefact Loi 25 : marketing/campagnes/2026-07-meta-test-controle/
// loi-25-artefact.md (données de navigation seulement, aucune identité).
const FB_PIXEL_ID = '2092349601673992';
const pixelInit = `!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${FB_PIXEL_ID}');fbq('track','PageView');`;
---
<div id="consentement" class="consentement" role="dialog" aria-live="polite" aria-label="Témoins" hidden>
  <p>On utilise des témoins pour mesurer les visites du site et l'efficacité de nos publicités. Rien n'est activé sans votre accord. <a href="/confidentialite">En savoir plus</a></p>
  <div class="consentement-btns">
    <button type="button" data-choix="non">Refuser</button>
    <button type="button" data-choix="oui" class="ok">Accepter</button>
  </div>
</div>
<style is:inline>
  .consentement{position:fixed;left:16px;bottom:16px;z-index:2147483000;max-width:420px;background:#121212;color:#E8E8E6;border:1px solid #232422;border-radius:14px;padding:16px 18px;font:400 14px/1.5 Inter,system-ui,sans-serif;box-shadow:0 12px 40px rgba(0,0,0,.45)}
  .consentement[hidden]{display:none}
  .consentement p{margin:0 0 12px}
  .consentement a{color:#B7D94C}
  .consentement-btns{display:flex;gap:8px;justify-content:flex-end}
  .consentement button{font:600 14px Inter,system-ui,sans-serif;border-radius:10px;padding:9px 16px;cursor:pointer;border:1px solid #3a3b38;background:transparent;color:#E8E8E6}
  .consentement button.ok{background:#B7D94C;border-color:#B7D94C;color:#0B0B0C}
  @media (max-width:520px){.consentement{left:12px;right:12px;bottom:12px;max-width:none}}
</style>
<script is:inline set:html={`if(typeof window.__fourniaPixel!=="function"){window.__fourniaPixel=function(){${pixelInit}};}`} />
<script is:inline>
(function(){
  var CLE='fournia-consentement', GA='G-HFPYMCE8Y9';
  function lire(){try{return localStorage.getItem(CLE)}catch(e){return null}}
  function ecrire(v){try{localStorage.setItem(CLE,v)}catch(e){}}
  function activer(){
    if(window.__fourniaMesure)return; window.__fourniaMesure=1;
    var s=document.createElement('script');
    s.src='https://link.saas-ai-system.com/js/external-tracking.js';
    s.setAttribute('data-tracking-id','tk_22f62d4d14b34cf3a115c0f48d8dad14');
    document.body.appendChild(s);
    if(typeof window.__fourniaPixel==='function')window.__fourniaPixel();
    var g=document.createElement('script'); g.async=true;
    g.src='https://www.googletagmanager.com/gtag/js?id='+GA;
    document.head.appendChild(g);
    window.dataLayer=window.dataLayer||[];
    window.gtag=function(){window.dataLayer.push(arguments)};
    gtag('js',new Date()); gtag('config',GA);
  }
  // Envoie un événement GA4 seulement si le visiteur a accepté (gtag n'existe qu'après le « oui »).
  window.fourniaEvent=function(nom,params){ if(typeof window.gtag==='function')window.gtag('event',nom,params||{}); };
  // ---- Mesure détaillée (envoyée seulement après le « oui ») ----
  var P=function(){return location.pathname};
  function txt(el){return (el.innerText||el.textContent||'').replace(/\s+/g,' ').trim().slice(0,80)}
  document.addEventListener('click',function(e){
    if(!e.target.closest)return;
    var a=e.target.closest('a,button'); if(!a)return;
    var href=a.getAttribute('href')||'';
    if(href.indexOf('calendly.com')>-1||href.indexOf('/widget/booking/')>-1)window.fourniaEvent('clic_reserver',{page:P(),texte:txt(a)});
    else if(href.indexOf('tel:')===0)window.fourniaEvent('clic_telephone',{page:P()});
    else if(href.indexOf('mailto:')===0)window.fourniaEvent('clic_courriel',{page:P()});
    if(a.classList && a.classList.contains('btn'))window.fourniaEvent('clic_cta',{page:P(),texte:txt(a)});
  });
  window.addEventListener('message',function(e){
    if(e.data && e.data.event==='calendly.event_scheduled')window.fourniaEvent('rdv_calendly',{page:P()});
  });
  // Formulaire du diagnostic : début de saisie (une fois).
  var commence=false;
  document.addEventListener('focusin',function(e){
    if(!commence && e.target.closest && e.target.closest('#qualForm')){commence=true;window.fourniaEvent('diagnostic_commence',{page:P()});}
  });
  // FAQ ouvertes (<details>).
  document.addEventListener('toggle',function(e){
    var d=e.target; if(d.tagName==='DETAILS' && d.open){var sm=d.querySelector('summary');window.fourniaEvent('faq_ouverte',{page:P(),question:sm?txt(sm):''});}
  },true);
  // Défilement 25/50/75/100 % et temps engagé 30 s / 60 s / 3 min (onglet visible seulement).
  var paliers={25:0,50:0,75:0,100:0};
  window.addEventListener('scroll',function(){
    var h=document.documentElement, max=h.scrollHeight-h.clientHeight; if(max<=0)return;
    var pct=Math.round((h.scrollTop||document.body.scrollTop)/max*100);
    [25,50,75,100].forEach(function(p){if(pct>=p && !paliers[p]){paliers[p]=1;window.fourniaEvent('defilement',{page:P(),pourcentage:p});
      if(p===75 && P().indexOf('/blog/')===0 && P()!=='/blog/')window.fourniaEvent('lecture_article',{article:P()});}});
  },{passive:true});
  var secondes=0;
  setInterval(function(){ if(document.visibilityState!=='visible')return; secondes+=5;
    if(secondes===30||secondes===60||secondes===180)window.fourniaEvent('temps_engage',{page:P(),secondes:secondes}); },5000);
  // Sections vues (éléments <section> avec un id), une fois chacune.
  if('IntersectionObserver' in window){
    var vu={}; var io=new IntersectionObserver(function(es){es.forEach(function(en){
      if(en.isIntersecting && !vu[en.target.id]){vu[en.target.id]=1;window.fourniaEvent('section_vue',{page:P(),section:en.target.id});}});},{threshold:0.2});
    document.querySelectorAll('section[id]').forEach(function(s){io.observe(s)});
  }
  // Bulle de clavardage (bouton dans le shadow DOM du widget de la plateforme).
  var essais=0, t=setInterval(function(){
    var w=document.querySelector('chat-widget'); var b=w && w.shadowRoot && w.shadowRoot.querySelector('#lc_text-widget--btn');
    if(b){clearInterval(t); b.addEventListener('click',function(){ if(!b.classList.contains('active'))window.fourniaEvent('chat_ouvert',{page:P()}); });}
    else if(++essais>40)clearInterval(t);
  },500);
  var boite=document.getElementById('consentement');
  var choix=lire();
  if(choix==='oui')activer(); else if(choix!=='non')boite.hidden=false;
  boite.addEventListener('click',function(e){
    var b=e.target.closest('[data-choix]'); if(!b)return;
    ecrire(b.getAttribute('data-choix')); boite.hidden=true;
    if(b.getAttribute('data-choix')==='oui'){activer();window.fourniaEvent('consentement_accepte',{page:P()});}
  });
  window.fourniaTemoins=function(){boite.hidden=false};
})();
</script>
