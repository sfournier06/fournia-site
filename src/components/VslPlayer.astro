---
// Lecteur VSL auto-hébergé de la landing /accompagnement-complet/ (utilisé seulement par cette page).
// Aucune plateforme tierce : <video> natif, rien ne se charge avant le clic (preload="none").
//
// VSL_SRC        : le MP4 final. Vide = on garde la vignette, et un clic affiche « La vidéo arrive bientôt ».
// VSL_APERCU_SRC : boucle muette de 3 à 5 s qui joue à la place de la photo (autoplay muted loop playsinline).
//                  Un clic charge alors VSL_SRC depuis le début, avec le son.
const VSL_SRC = '';
const VSL_APERCU_SRC = '';

// Vignette : photo réelle de Simon (même source que le composant Portrait), cadrage serré, assombrie.
import { PHOTO_SIMON } from '../data/fondateur.mjs';
// Durée : le VSL v9 fait environ 4 min 40 (version A) ; remplacer par la durée exacte après le montage.
const DUREE = 'moins de 5 min';
---
<div class="vsl-bloc" data-vsl data-src={VSL_SRC} data-apercu={VSL_APERCU_SRC}>

  <div class="vsl-cadre">
    <video
      class="vsl-video"
      preload="none"
      playsinline
      poster={PHOTO_SIMON}
      {...(VSL_APERCU_SRC ? { src: VSL_APERCU_SRC, autoplay: true, muted: true, loop: true } : {})}
    >
      <!-- Sous-titres : brancher le fichier VTT quand le VSL final existe.
      <track kind="captions" srclang="fr" label="Français" src="/videos/vsl-accompagnement.vtt" default />
      -->
    </video>

    <div class="vsl-vignette">
      {!VSL_APERCU_SRC && <img class="vsl-photo" src={PHOTO_SIMON} alt="" width="960" height="1200" loading="lazy" decoding="async" />}
      <div class="vsl-voile"></div>
      <!-- Le texte à gauche, le visage dégagé à droite : le regard caméra fait la confiance, rien ne le cache. -->
      <div class="vsl-texte">
        <p class="vsl-accroche">L'étape que presque personne ne fait</p>
        <p class="vsl-titre">Pourquoi ton outil d'IA <em>dort</em></p>
        <div class="vsl-action">
          <span class="vsl-play" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
          </span>
          <span class="vsl-action-txt"><strong>Regarde la vidéo</strong><span>{DUREE}<span class="vsl-son">, avec le son</span></span></span>
        </div>
      </div>
      <!-- Toute la vignette est cliquable (une seule cible, lisible par les lecteurs d'écran) -->
      <button type="button" class="vsl-clic" aria-label={`Lire la vidéo : Pourquoi ton outil d'IA dort (${DUREE})`}></button>
      <p class="vsl-bientot" role="status" hidden>La vidéo arrive bientôt.</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-vsl]').forEach((bloc) => {
    const src = bloc.dataset.src || '';
    const video = bloc.querySelector<HTMLVideoElement>('.vsl-video')!;
    const vignette = bloc.querySelector<HTMLElement>('.vsl-vignette')!;
    const play = bloc.querySelector<HTMLButtonElement>('.vsl-clic')!;
    const bientot = bloc.querySelector<HTMLElement>('.vsl-bientot')!;

    play.addEventListener('click', () => {
      if (!src) { bientot.hidden = false; return; }
      video.loop = false;
      video.muted = false;
      video.src = src;
      video.currentTime = 0;
      video.controls = true;
      vignette.hidden = true;
      video.play().catch(() => {});
    });

    // Suivi de visionnement : une seule fois chaque palier, seulement pour le VSL final (pas l'aperçu).
    // fourniaEvent (Consentement.astro) n'envoie rien tant que le visiteur n'a pas accepté.
    // Meta : brancher après /loi25.
    const paliers: [number, string][] = [[0, 'vsl_debut'], [25, 'VSL_25'], [50, 'VSL_50'], [75, 'VSL_75'], [95, 'VSL_95']];
    const envoyes = new Set<string>();
    video.addEventListener('timeupdate', () => {
      if (!src || !video.currentSrc.includes(src) || !video.duration) return;
      const pct = (video.currentTime / video.duration) * 100;
      for (const [seuil, nom] of paliers) {
        if (pct >= seuil && video.currentTime > 0 && !envoyes.has(nom)) {
          envoyes.add(nom);
          (window as any).fourniaEvent?.(nom, { page: location.pathname, video: 'vsl-accompagnement' });
        }
      }
    });
  });
</script>

<style>
  .vsl-bloc { width: 100%; }
  .vsl-etiquette { display: inline-flex; align-items: center; gap: .5rem; font-size: .9rem; font-weight: 600; color: var(--lime); margin: 0 0 .9rem; letter-spacing: .01em; }
  .vsl-etiquette svg { width: .8rem; height: .8rem; }

  .vsl-cadre { position: relative; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; border: 1px solid var(--glass-b); background: #0d0e0c;
    box-shadow: 0 30px 70px rgba(0,0,0,.55); }
  .vsl-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #0d0e0c; }
  .vsl-vignette { position: absolute; inset: 0; display: grid; place-items: center; }
  .vsl-vignette[hidden] { display: none; }
  .vsl-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; transform: translateX(22%) scale(1.05); }
  .vsl-voile { position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(11,11,12,.88) 0%, rgba(11,11,12,.55) 55%, rgba(11,11,12,.35) 100%), linear-gradient(0deg, rgba(11,11,12,.5), transparent 45%); }

  .vsl-texte { position: absolute; left: 6%; top: 50%; transform: translateY(-50%); max-width: 52%; z-index: 1; text-align: left; pointer-events: none; }
  .vsl-accroche { margin: 0 0 .7rem; font-size: clamp(.62rem, 1.35vw, .95rem); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--lime); }
  .vsl-titre { margin: 0; font-family: 'Anton', 'Arial Narrow', sans-serif; text-transform: uppercase; font-size: clamp(1.55rem, 5.8vw, 4rem); line-height: 1.04; letter-spacing: .01em; color: #fff;
    text-shadow: 0 2px 18px rgba(0,0,0,.45); }
  .vsl-titre em { font-style: normal; color: var(--lime); }
  .vsl-action { display: flex; align-items: center; gap: .9rem; margin-top: clamp(.8rem, 2.4vw, 1.6rem); }
  .vsl-play { flex: none; width: clamp(44px, 7.4vw, 72px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--lime); color: #0b0b0c;
    box-shadow: 0 0 0 0 rgba(183,217,76,.45), 0 12px 30px rgba(0,0,0,.5); animation: vsl-pouls 2.4s cubic-bezier(.16,1,.3,1) infinite; transition: transform .3s cubic-bezier(.16,1,.3,1); }
  .vsl-play svg { width: 44%; height: 44%; margin-left: 8%; }
  .vsl-action-txt { display: flex; flex-direction: column; line-height: 1.25; }
  .vsl-action-txt strong { font-size: clamp(.82rem, 1.6vw, 1.12rem); color: #fff; }
  .vsl-action-txt span { font-size: clamp(.7rem, 1.25vw, .9rem); color: #c9cbc3; }
  .vsl-clic { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; border: 0; padding: 0; margin: 0; background: transparent; cursor: pointer; border-radius: inherit; }
  .vsl-clic:focus-visible { outline: 3px solid var(--lime); outline-offset: -3px; }
  .vsl-cadre:hover .vsl-play { transform: scale(1.08); }
  @keyframes vsl-pouls { 0% { box-shadow: 0 0 0 0 rgba(183,217,76,.45), 0 12px 30px rgba(0,0,0,.5); } 70%, 100% { box-shadow: 0 0 0 18px rgba(183,217,76,0), 0 12px 30px rgba(0,0,0,.5); } }
  @media (prefers-reduced-motion: reduce) { .vsl-play { animation: none; } }

  .vsl-bientot { position: absolute; left: 6%; bottom: 1rem; z-index: 2; margin: 0; font-size: .92rem; font-weight: 600; color: #0b0b0c; background: var(--lime); border-radius: 100px; padding: .4rem 1rem; white-space: nowrap; }

  @media (max-width: 560px) {
    .vsl-texte { left: 5.5%; max-width: 58%; }
    .vsl-accroche { margin-bottom: .4rem; letter-spacing: .08em; }
    .vsl-titre { font-size: 1.5rem; }
    .vsl-action { gap: .55rem; }
    .vsl-son { display: none; }
    .vsl-bientot { font-size: .82rem; padding: .3rem .8rem; bottom: .7rem; }
  }
</style>
