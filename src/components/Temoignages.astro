---
// Témoignages clients, lus depuis src/data/temoignages.mjs.
// N'affiche RIEN tant qu'aucune entrée n'a de consentement écrit (consentement.date).
import { TEMOIGNAGES } from '../data/temoignages.mjs';

const { titre = 'Ce que nos clients en disent' } = Astro.props;
const valides = TEMOIGNAGES.filter((t) => t && t.citation && t.nom && t.consentement && t.consentement.date);
---
{valides.length > 0 && (
  <section class="temoignages" id="temoignages" aria-labelledby="temoignages-titre">
    <div class="wrap">
      <h2 id="temoignages-titre">{titre}</h2>
      <div class="liste">
        {valides.map((t) => (
          <figure>
            <blockquote>{t.citation}</blockquote>
            <figcaption>
              <strong>{t.nom}</strong>
              {(t.role || t.entreprise) && <span>{[t.role, t.entreprise].filter(Boolean).join(', ')}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .temoignages { position: relative; z-index: 1; padding: 4rem 0; }
  h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -.02em; margin-bottom: 2rem; }
  .liste { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
  figure { margin: 0; padding: 1.8rem; border-radius: 18px; border: 1px solid var(--line); background: var(--glass); }
  blockquote { color: var(--white); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.2rem; }
  figcaption strong { display: block; font-family: 'Space Grotesk', sans-serif; }
  figcaption span { color: var(--mute); font-size: .9rem; }
</style>
