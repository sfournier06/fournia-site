---
// Liens vers les profils publics de FournIA (pied de page). Même source que le schéma : src/data/entite.mjs.
import { RESEAUX } from '../data/entite.mjs';
const { lang = 'fr' } = Astro.props;
const icones = {
  instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.9 8.8H3.6V20h3.3V8.8zM5.2 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8zM20.4 13.6c0-3-1.6-5-4.4-5-1.4 0-2.4.8-2.8 1.5V8.8H10V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.3l-.1-6.4z"/></svg>',
  google: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.4 10.2H12v3.9h5.4c-.5 2.4-2.6 3.8-5.4 3.8a6 6 0 1 1 0-12c1.5 0 2.8.5 3.8 1.4l2.9-2.9A10 10 0 1 0 22 12c0-.6-.2-1.2-.6-1.8z"/></svg>',
};
---
<ul class="reseaux" aria-label={lang === 'en' ? 'FournIA on social media' : 'FournIA sur les réseaux sociaux'}>
  {RESEAUX.map((r) => (
    <li><a href={r.url} target="_blank" rel="noopener" aria-label={lang === 'en' ? r.label_en : r.label} title={lang === 'en' ? r.label_en : r.label} set:html={icones[r.icone]}></a></li>
  ))}
</ul>
<style>
  .reseaux { list-style: none; margin: 1.2rem 0 0; padding: 0; display: flex; gap: .6rem; }
  .reseaux a { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); display: grid; place-items: center; color: var(--mute); transition: color .2s, border-color .2s; }
  .reseaux a:hover { color: var(--lime); border-color: rgba(183,217,76,.5); }
  .reseaux :global(svg) { width: 18px; height: 18px; }
</style>
