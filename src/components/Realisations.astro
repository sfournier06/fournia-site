---
// Carrousel des systèmes livrés (src/data/realisations.mjs), une carte par secteur.
// Nom, logo, photo, résultat, témoignage et vidéo du client ne s'affichent que si l'entrée porte un
// consentement écrit daté. Sans lui : carte anonyme (secteur + système).
import { REALISATIONS } from '../data/realisations.mjs';
import { APERCU } from '../data/apercu.mjs';
import { enAnglais } from '../data/traductions.mjs';

// sansImageSecteur : la landing n'affiche aucune photo décorative de secteur (leçon du 2026-11-20 : chaque image est une preuve).
const { limite, court = false, lang = 'fr', sansImageSecteur = false } = Astro.props;
const en = lang === 'en';
// Textes de l'interface. En anglais, le lien « Voir le secteur » mène à la page anglaise du secteur (enAnglais).
const T = en
  ? { aria: 'Delivered systems by sector', enCours: 'In progress', emplacement: 'Placeholder: written or video testimonial from', video: 'Watch the video testimonial', secteur: 'See the industry', prec: 'Previous example', suiv: 'Next example', avisGoogle: 'Google review', note5: '5 out of 5', resultat: 'Result', confidentiel: 'Confidential client', detail: 'See how it works', fermer: 'Close' }
  : { aria: 'Systèmes livrés par secteur', enCours: 'En cours', emplacement: 'Emplacement : témoignage écrit ou vidéo de', video: 'Voir le témoignage vidéo', secteur: 'Voir le secteur', prec: 'Exemple précédent', suiv: 'Exemple suivant', avisGoogle: 'avis Google', note5: '5 sur 5', resultat: 'Résultat', confidentiel: 'Client confidentiel', detail: 'Voir comment ça marche', fermer: 'Fermer' };
// Champ traduit s'il existe (ex. titre_en), sinon le français.
const tr = (r, champ) => (en && r[`${champ}_en`]) || r[champ];
const liste = typeof limite === 'number' ? REALISATIONS.slice(0, limite) : REALISATIONS;
// En aperçu interne (APERCU=1), on affiche tout pour voir le rendu final. Jamais en production.
const autorise = (r) => APERCU || Boolean(r.consentement && r.consentement.date);
const initiale = (s) => s.trim().charAt(0).toUpperCase();
const id = `car-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="carrousel" data-carrousel>
  <ul class="piste" id={id} tabindex="0" aria-label={T.aria}>
    {liste.map((r, n) => {
      const ok = autorise(r);
      const dlg = `${id}-d${n}`;
      return (
        <li class:list={['carte', { cliquable: court }]}>
          {ok && r.photo ? (
            <div class="bandeau-photo client"><img src={r.photo} alt={r.client ?? ''} loading="lazy" decoding="async" width="800" height="600" /></div>
          ) : ok && r.logo && !(r.prefereImage && r.image) ? (
            <div class="bandeau-logo"><img src={r.logo} alt={r.client ?? ''} loading="lazy" decoding="async" /></div>
          ) : r.image && !sansImageSecteur ? (
            <div class="bandeau-photo"><img src={r.image} alt="" loading="lazy" decoding="async" width="800" height="600" /></div>
          ) : null}
          <div class="tete">
            {!(ok && r.logo) && !(r.image && !sansImageSecteur) && <span class="monogramme" aria-hidden="true">{initiale(ok && r.client ? r.client : tr(r, 'secteur'))}</span>}
            <div>
              <p class="secteur">{ok && r.client ? r.client : tr(r, 'secteur')}</p>
              <p class="sous-secteur">{ok && r.client ? tr(r, 'secteur') : T.confidentiel}</p>
            </div>
          </div>
          <h3>{court ? <button type="button" class="ouvrir" data-dlg={dlg} aria-haspopup="dialog">{tr(r, 'titre')}</button> : tr(r, 'titre')}</h3>
          {!court && <p class="systeme">{tr(r, 'systeme')}</p>}
          {court && <span class="voir" aria-hidden="true">{T.detail} <span>→</span></span>}
          {r.resultat_carte && (
            <div class="res">
              <p class="res-lbl">{T.resultat}</p>
              <p class="res-txt">{tr(r, 'resultat_carte')}</p>
            </div>
          )}
          {ok && r.resultat && <p class="resultat">{r.resultat}</p>}
          {ok && r.temoignage && (
            <blockquote class="temoignage">
              <p>« {r.temoignage.texte} »</p>
              <footer>{r.temoignage.auteur}{r.temoignage.role && `, ${r.temoignage.role}`}</footer>
            </blockquote>
          )}
          {court && (
            <dialog class="detail" id={dlg} aria-label={tr(r, 'titre')}>
              <button type="button" class="fermer" data-fermer aria-label={T.fermer}>×</button>
              {ok && r.photo ? <div class="detail-visuel photo"><img src={r.photo} alt="" /></div>
                : ok && r.logo ? <div class="detail-visuel"><img src={r.logo} alt="" /></div>
                : r.image && !sansImageSecteur ? <div class="detail-visuel photo"><img src={r.image} alt="" /></div> : null}
              <div class="detail-corps">
              <p class="secteur">{ok && r.client ? r.client : tr(r, 'secteur')}</p>
              <p class="sous-secteur">{ok && r.client ? tr(r, 'secteur') : T.confidentiel}</p>
              <h3>{tr(r, 'titre')}</h3>
              <p class="systeme">{tr(r, 'systeme')}</p>
              {r.resultat_carte && (
                <div class="res">
                  <p class="res-lbl">{T.resultat}</p>
                  <p class="res-txt">{tr(r, 'resultat_carte')}</p>
                </div>
              )}
              {r.lien && <a class="lien" href={en ? enAnglais(r.lien) : r.lien}>{T.secteur} <span aria-hidden="true">→</span></a>}
              </div>
            </dialog>
          )}
          {!court && <div class="liens">
            {ok && r.video && <a class="lien" href={r.video} target="_blank" rel="noopener">{T.video} <span aria-hidden="true">→</span></a>}
            {r.lien && <a class="lien" href={en ? enAnglais(r.lien) : r.lien}>{T.secteur} <span aria-hidden="true">→</span></a>}
          </div>}
        </li>
      );
    })}
  </ul>
  <div class="controles">
    <button type="button" class="fleche" data-dir="-1" aria-controls={id} aria-label={T.prec}>←</button>
    <button type="button" class="fleche" data-dir="1" aria-controls={id} aria-label={T.suiv}>→</button>
  </div>
</div>

<script>
  // carte cliquable : ouvre la boîte de détail ; clic sur le fond ou × pour fermer
  document.querySelectorAll('.ouvrir[data-dlg]').forEach((b) => {
    const d = document.getElementById(b.dataset.dlg);
    if (!d) return;
    b.addEventListener('click', () => d.showModal());
    d.addEventListener('click', (e) => { if (e.target === d || e.target.closest('[data-fermer]')) d.close(); });
  });
  document.querySelectorAll('[data-carrousel]').forEach((c) => {
    const piste = c.querySelector('.piste');
    c.querySelectorAll('.fleche').forEach((b) => {
      b.addEventListener('click', () => {
        const carte = piste.querySelector('.carte');
        const pas = carte ? carte.getBoundingClientRect().width + 20 : piste.clientWidth;
        piste.scrollBy({ left: pas * Number(b.dataset.dir), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .carrousel { margin: 0 0 1.4rem; }
  ul.piste.piste { list-style: none; margin: 0; padding: 0 0 1rem; display: grid; grid-auto-flow: column;
    grid-auto-columns: minmax(280px, calc((100% - 40px) / 3)); gap: 20px; overflow-x: auto;
    scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  /* pas de barre de défilement visible : on navigue avec les flèches ou au doigt */
  ul.piste.piste::-webkit-scrollbar { display: none; }
  .piste:focus-visible { outline: 2px solid var(--lime); outline-offset: 4px; }
  .carte { scroll-snap-align: start; margin: 0; padding: 1.5rem; border: 1px solid var(--line); border-radius: 14px;
    display: flex; flex-direction: column; background: rgba(255,255,255,.02); }
  .photo { width: calc(100% + 3rem); margin: -1.5rem -1.5rem 1.2rem; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 14px 14px 0 0; }
  .tete { display: flex; align-items: center; gap: .8rem; margin-bottom: .7rem; }
  .monogramme { flex: none; width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center;
    background: rgba(200,255,0,.08); color: var(--lime); font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 1.15rem; }
  /* tuile du haut : même hauteur pour logo, photo et image de secteur ; fond blanc pur pour que les logos
     livrés sur fond blanc s'y fondent ; logos ramenés à une hauteur optique commune */
  .bandeau-logo { margin: -1.5rem -1.5rem 1.4rem; height: 120px; border-radius: 14px 14px 0 0; background: #fff;
    display: grid; place-items: center; padding: 0 28px; }
  .bandeau-logo img { height: 46px; width: auto; max-width: 72%; object-fit: contain; }
  .bandeau-photo { margin: -1.5rem -1.5rem 1.4rem; height: 120px; border-radius: 14px 14px 0 0; overflow: hidden; }
  .bandeau-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bandeau-photo.client { height: 120px; }
  /* le résultat ressort : bandeau lime en bas de carte, texte blanc plus gros et plus gras */
  .res { margin: auto -1.5rem -1.5rem; padding: 1.1rem 1.5rem 1.3rem; border-top: 1px solid rgba(183,217,76,.35);
    background: linear-gradient(180deg, rgba(183,217,76,.14), rgba(183,217,76,.06)); border-radius: 0 0 14px 14px; }
  .res-lbl { margin: 0 0 .35rem; color: var(--lime); font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .res-txt { margin: 0; color: #fff; font-size: 1.08rem; line-height: 1.4; font-weight: 600; letter-spacing: -.005em; min-height: 5.6em; }
  .detail .res-txt { min-height: 0; }
  /* carte cliquable : le bouton du titre couvre toute la carte */
  .carte.cliquable { position: relative; transition: border-color .25s, transform .3s cubic-bezier(.2,.8,.3,1); }
  .carte.cliquable:hover { border-color: rgba(183,217,76,.45); transform: translateY(-3px); }
  .ouvrir { all: unset; cursor: pointer; }
  .ouvrir::after { content: ''; position: absolute; inset: 0; border-radius: 14px; }
  .ouvrir:focus-visible::after { outline: 2px solid var(--lime); outline-offset: 2px; }
  .voir { display: inline-flex; gap: .35rem; color: var(--mute); font-size: .85rem; margin: 0 0 1.2rem; transition: color .2s; }
  .carte.cliquable:hover .voir { color: var(--lime); }
  /* le reset global met margin: 0 partout : on recentre la boîte au milieu de l'écran */
  .detail { margin: auto; padding: 0 !important; width: min(560px, calc(100vw - 32px)); max-height: calc(100vh - 48px); overflow: auto; padding: 2rem; border-radius: 18px;
    border: 1px solid var(--glass-b); background: #121212; color: var(--white); }
  .detail::backdrop { background: rgba(0,0,0,.7); backdrop-filter: blur(4px); }
  .carte .detail h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.45rem; margin: .5rem 0 .9rem; line-height: 1.25; min-height: 0; }
  .detail-corps { padding: 1.8rem 2rem 2rem; }
  .detail-visuel { height: 170px; background: #fff; display: grid; place-items: center; overflow: hidden; border-radius: 18px 18px 0 0; }
  .detail-visuel img { max-height: 70px; max-width: 60%; object-fit: contain; }
  .detail-visuel.photo img { width: 100%; height: 100%; max-height: none; max-width: none; object-fit: cover; object-position: 50% 40%; }
  .detail .secteur { padding-right: 3rem; }
  .detail .systeme { color: var(--mute); line-height: 1.6; margin: 0 0 1.4rem; }
  .detail .res { margin: 0 0 1.2rem; border-radius: 12px; border: 1px solid rgba(183,217,76,.35); }
  .detail .fermer { position: absolute; z-index: 2; top: .8rem; right: .9rem; background: rgba(18,18,18,.8) !important; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line);
    background: transparent; color: var(--white); font-size: 1.3rem; cursor: pointer; }
  .detail .fermer:hover { border-color: var(--lime); color: var(--lime); }
  .temoignage p:not(.etoiles) { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bandeau-photo.client img { object-position: 50% 45%; }
  .temoignage .etoiles { color: #f5c518; letter-spacing: .12em; font-size: .8rem; margin: 0 0 .3rem; }
  .emplacement { margin: 0 0 1rem; padding: .7rem .8rem; border: 1px dashed var(--line); border-radius: 10px; color: var(--mute); font-size: .85rem; }
  /* dans une page de service, la classe .prose ajoute des marges aux paragraphes : on les neutralise dans les cartes */
  .carte .secteur { color: var(--lime); font-size: .9rem; font-weight: 500; margin: 0 !important; }
  .carte .sous-secteur, .carte .res-lbl, .carte .res-txt { margin-top: 0 !important; }
  .sous-secteur { color: var(--mute); font-size: .82rem; margin: .1rem 0 0; }
  .statut { margin-left: auto; font-size: .75rem; color: var(--mute); border: 1px solid var(--line); border-radius: 99px; padding: .15rem .6rem; }
  .carte h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.2rem; line-height: 1.25; letter-spacing: -.01em; color: var(--white); margin: 0 0 1rem; min-height: 3.75em; }
  .systeme { color: var(--mute); font-size: .98rem; line-height: 1.6; margin: 0 0 1rem; }
  .resultat { color: var(--white); font-weight: 500; margin: 0 0 1rem; }
  .temoignage { margin: 0 0 1rem; padding: 0 0 0 .9rem; border-left: 2px solid var(--lime); }
  .temoignage p { color: var(--white); font-size: .98rem; line-height: 1.55; margin: 0 0 .4rem; }
  .temoignage footer { color: var(--mute); font-size: .85rem; }
  .liens { margin-top: auto; display: flex; flex-direction: column; gap: .35rem; }
  .lien { color: var(--mute); font-size: .9rem; text-decoration: none; transition: color .2s; }
  .lien:hover { color: var(--lime); }
  .controles { display: flex; gap: .5rem; justify-content: flex-end; }
  .fleche { width: 44px; height: 44px; border-radius: 99px; border: 1px solid var(--line); background: transparent;
    color: var(--white); font-size: 1.1rem; cursor: pointer; transition: border-color .2s, color .2s; }
  .fleche:hover, .fleche:focus-visible { border-color: var(--lime); color: var(--lime); }
  @media (max-width: 900px) { ul.piste { grid-auto-columns: minmax(260px, 78%); } }
  @media (prefers-reduced-motion: reduce) { ul.piste { scroll-behavior: auto; } }
</style>
