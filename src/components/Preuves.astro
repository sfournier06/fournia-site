---
// Preuves sociales de l'accueil : témoignages vidéo + avis Google.
// Production : seulement les vrais éléments (avis copiés mot pour mot dans src/data/avis.mjs,
// vidéos de clients avec consentement écrit dans src/data/temoignages.mjs). Rien de réel = rien d'affiché.
// Aperçu interne (APERCU=1) : des cartes MAQUETTES marquées « Exemple » montrent la mise en page.
// Leur texte est fictif et ne doit JAMAIS être publié (Loi sur la concurrence, faux témoignages).
import { AVIS, LIEN_FICHE_GOOGLE, LIEN_LAISSER_AVIS } from '../data/avis.mjs';
import { TEMOIGNAGES } from '../data/temoignages.mjs';
import { APERCU } from '../data/apercu.mjs';

const { lang = 'fr' } = Astro.props;
const en = lang === 'en';
// Textes de l'interface. Les avis restent TOUJOURS dans leur langue d'origine (jamais traduits).
const T = en
  ? { etiquette: 'Testimonials', titre: 'What clients say', origine: 'Reviews shown in their original language (French).',
      maquette: 'Internal preview: the "Example" cards are layout mockups. They will be replaced by real testimonials and reviews, with written consent. Nothing fictional is published.',
      exemple: 'Example', avisGoogle: 'Google reviews', sur5: 'out of 5', avis: 'reviews', voir: 'See the reviews on Google →', laisser: 'A FournIA client? Leave a review', note5: '5 out of 5', decimale: '.' }
  : { etiquette: 'Témoignages', titre: 'Ce que les clients en disent', origine: null,
      maquette: "Aperçu interne : les cartes « Exemple » sont des maquettes de mise en page. Elles sont remplacées par les vrais témoignages et avis, avec accord écrit. Rien de fictif n'est publié.",
      exemple: 'Exemple', avisGoogle: 'Avis Google', sur5: 'sur 5', avis: 'avis', voir: 'Voir les avis sur Google →', laisser: 'Client de FournIA ? Laissez un avis', note5: '5 sur 5', decimale: ',' };

const ok = (x) => Boolean(x && x.consentement && x.consentement.date);
const avis = AVIS.filter((a) => a && a.texte && a.auteur && a.publier !== false);
const videos = TEMOIGNAGES.filter((t) => ok(t) && t.video);

// Miniatures de personnes FICTIVES générées par IA (public/apercu/), pour tester la mise en page seulement.
const MAQUETTE_VIDEOS = en ? [
  { nom: 'Owner, caterer', sujet: 'Our service proposals go out in minutes', image: '/apercu/t1.webp' },
  { nom: 'Director, tutoring centre', sujet: 'New requests get answered right away', image: '/apercu/t2.webp' },
  { nom: 'Owner, audio rental', sujet: 'No request slips through the cracks anymore', image: '/apercu/t3.webp' },
] : [
  { nom: 'Propriétaire, traiteur', sujet: 'Nos offres de service sortent en quelques minutes', image: '/apercu/t1.webp' },
  { nom: 'Directeur, centre de tutorat', sujet: 'Les nouvelles demandes sont répondues tout de suite', image: '/apercu/t2.webp' },
  { nom: 'Propriétaire, location audio', sujet: 'Plus aucune demande ne passe entre deux craques', image: '/apercu/t3.webp' },
];
const MAQUETTE_AVIS = en ? [
  { auteur: 'First name L.', texte: 'Sample text: Simon took the time to understand how we work before suggesting anything. The system has been running ever since and the team uses it every day.' },
  { auteur: 'First name L.', texte: 'Sample text: Clear explanations, no jargon. We always knew where the project stood.' },
  { auteur: 'First name L.', texte: 'Sample text: Delivered quickly, training included, and he answers when we have a question.' },
] : [
  { auteur: 'Prénom N.', texte: "Texte d'exemple : Simon a pris le temps de comprendre comment on travaille avant de proposer quoi que ce soit. Le système roule depuis et l'équipe l'utilise tous les jours." },
  { auteur: 'Prénom N.', texte: "Texte d'exemple : Explications claires, sans jargon. On savait toujours où en était le projet." },
  { auteur: 'Prénom N.', texte: "Texte d'exemple : Livré rapidement, formation incluse, et il répond quand on a une question." },
];

const montrerVideos = false; // Pas de vidéos pour l'instant (décision de Simon, 2026-11-17) : seulement les avis Google.
const montrerAvis = avis.length > 0 || APERCU;
const etoiles = '★★★★★';
---
{(montrerVideos || montrerAvis) && (
  <section id="preuves" class="preuves" aria-labelledby="preuves-titre">
    <div class="wrap">
      <p class="etiquette">{T.etiquette}</p>
      <h2 id="preuves-titre" class="sec-title">{T.titre}</h2>
      {APERCU && avis.length === 0 && <p class="maquette">{T.maquette}</p>}

      {montrerAvis && (
        <div class="avis">
          <div class="note-globale">
            <span class="g" aria-hidden="true">G</span>
            <div><strong>{T.avisGoogle}</strong><span class="etoiles">{etoiles}</span>{avis.length > 0 && <span class="moyenne">{`${(avis.reduce((t, x) => t + x.note, 0) / avis.length).toFixed(1).replace('.', T.decimale)} ${T.sur5} · ${avis.length} ${T.avis}`}</span>}</div>
            {LIEN_FICHE_GOOGLE && <a href={LIEN_FICHE_GOOGLE} target="_blank" rel="noopener">{T.voir}</a>}
            {T.origine && avis.length > 0 && <span class="origine">{T.origine}</span>}
            {LIEN_LAISSER_AVIS && <a class="laisser" href={LIEN_LAISSER_AVIS} target="_blank" rel="noopener">{T.laisser}</a>}
          </div>
          {(avis.length > 0 ? avis : MAQUETTE_AVIS).map((a) => (
            <figure class:list={['carte-avis', { exemple: avis.length === 0 }]}>
              {avis.length === 0 && <span class="badge">{T.exemple}</span>}
              <p class="etoiles" aria-label={T.note5}>{etoiles}</p>
              <blockquote lang={en && avis.length > 0 ? 'fr' : undefined}>{a.texte}</blockquote>
              <figcaption>
                <strong>{a.auteur}</strong>
                {a.systeme && <span class="systeme">{en ? (a.systeme_en || a.systeme) : a.systeme}</span>}
                {a.secteur && <span class="secteur">{en ? (a.secteur_en || a.secteur) : a.secteur}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .preuves { position: relative; z-index: 1; padding: 7rem 0; }
  .maquette { color: var(--mute); font-size: .88rem; border-left: 2px solid var(--lime); padding-left: .9rem; margin: -0.4rem 0 2.4rem; max-width: 46rem; }
  .videos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; margin-bottom: 1.4rem; }
  .video { position: relative; aspect-ratio: 4 / 5; isolation: isolate; border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end;
    padding: 1.5rem; text-decoration: none; color: var(--white); border: 1px solid var(--line);
    background: radial-gradient(120% 80% at 50% 20%, #23251f, #111211 70%); transition: border-color .3s, transform .4s cubic-bezier(.2,.8,.3,1); }
  a.video:hover, .video:hover { border-color: rgba(183,217,76,.4); transform: translateY(-4px); }
  .video .fond { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.05) 40%, rgba(0,0,0,.85)); }
  .video .play, .video .legende, .video .badge { z-index: 2; }
  .video .logo { position: absolute; top: 1.5rem; left: 1.5rem; height: 26px; width: auto; max-width: 45%; opacity: .7; }
  .play { position: absolute; top: 50%; left: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%;
    background: var(--lime); box-shadow: 0 0 0 10px rgba(183,217,76,.12); transition: box-shadow .3s; }
  .play::after { content: ''; position: absolute; left: 26px; top: 21px; border-left: 16px solid #0b0b0c; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .video:hover .play { box-shadow: 0 0 0 16px rgba(183,217,76,.1); }
  .legende { display: flex; flex-direction: column; gap: .3rem; position: relative; }
  .legende strong { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 1.05rem; line-height: 1.3; }
  .legende span { color: var(--mute); font-size: .86rem; }
  .badge { position: absolute; top: 1.2rem; right: 1.2rem; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: #0b0b0c;
    background: #e9c46a; border-radius: 6px; padding: .2rem .5rem; font-weight: 600; z-index: 2; }
  /* en-tête de note sur toute la largeur, puis les avis en colonnes (hauteurs libres, aucun trou) */
  .avis { columns: 3; column-gap: 1.4rem; }
  .avis > .carte-avis { break-inside: avoid; margin-bottom: 1.4rem; }
  .note-globale { column-span: all; display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.6rem; padding: 0 0 2rem; }
  .note-globale .g { width: 40px; height: 40px; border-radius: 50%; background: #fff; color: #4285f4; display: grid; place-items: center;
    font-family: Arial, sans-serif; font-weight: 700; font-size: 1.2rem; }
  .note-globale strong { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; }
  .note-globale a { color: var(--lime); font-size: .9rem; }
  .note-globale a.laisser { color: var(--mute); font-size: .84rem; }
  .note-globale .origine { color: var(--mute); font-size: .8rem; font-style: italic; max-width: 22ch; }
  .note-globale .moyenne { display: block; color: var(--mute); font-size: .86rem; margin-top: .2rem; }
  .etoiles { color: #f5c518; letter-spacing: .12em; font-size: .95rem; }
  .carte-avis { position: relative; margin: 0; padding: 1.6rem; border-radius: 16px; border: 1px solid var(--line); background: rgba(255,255,255,.02);
    display: flex; flex-direction: column; gap: .9rem; }
  .carte-avis blockquote { color: var(--white); font-size: .96rem; line-height: 1.6; margin: 0; flex: 1; }
  .carte-avis figcaption { display: flex; flex-direction: column; gap: .25rem; padding-top: .9rem; border-top: 1px solid var(--line); }
  .carte-avis figcaption strong { color: var(--white); font-size: .92rem; font-weight: 600; }
  .carte-avis figcaption .systeme { color: var(--lime); font-size: .84rem; }
  .carte-avis figcaption .secteur { color: var(--mute); font-size: .8rem; }
  @media (max-width: 960px) {
    .avis { columns: 2; }
    .videos { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .preuves { padding: 4.5rem 0; }
    .avis { columns: 1; }
    .videos { grid-template-columns: 1fr; }
    .video { aspect-ratio: 16 / 11; }
  }
</style>
