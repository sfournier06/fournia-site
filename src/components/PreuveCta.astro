---
// Preuve juste au-dessus d'un bouton d'appel (étape 9 de Sabri Suby : « juste au-dessus de chaque appel à
// l'action, montre visuellement la preuve »). UNE preuve à la fois, assez grande pour être lue : une preuve
// qu'on ne peut pas lire a l'air fausse. Seulement du réel :
// - loi25    : extrait de l'exemple de dossier Loi 25 (entreprise fictive, marqué comme tel) ;
// La note Google n'apparaît qu'une fois, en haut de page (décision de Simon, 2026-11-20 : 5 avis, c'est le début).
// L'écran du traiteur est retiré : pas d'accord écrit du client pour l'écran (Simon, 2026-11-20).
// - diag     : extrait de l'exemple de diagnostic écrit (entreprise fictive, marqué comme tel) ;
// - garantie : les termes exacts de la garantie (page, étape 15).
// Ajouter un type ici quand une nouvelle capture arrive (marketing/publicites/preuves-visuelles.md).
const { type = 'diag' } = Astro.props;
---
{type === 'loi25' && (
  <figure class="preuve-cta">
    <div class="pc-cadre pc-clair">
      <img src="/preuves/extrait-loi25.webp" alt="Extrait d'un dossier Loi 25 FournIA : le flux de données et les portes de conformité (exemple pour une entreprise fictive)" width="842" height="498" loading="lazy" decoding="async" />
      <span class="pc-badge">Exemple · données fictives</span>
    </div>
    <figcaption>Ton dossier Loi 25 ressemble à ça : quelles données chaque système touche, où elles vont, et qui y a accès.</figcaption>
  </figure>
)}
{type === 'diag' && (
  <figure class="preuve-cta">
    <div class="pc-cadre pc-clair">
      <img src="/preuves/extrait-diagnostic.webp" alt="Extrait d'un diagnostic écrit FournIA : ce que le client a dit, en ses mots (exemple pour une entreprise fictive)" width="842" height="498" loading="lazy" decoding="async" />
      <span class="pc-badge">Exemple · données fictives</span>
    </div>
    <figcaption>Ton diagnostic écrit ressemble à ça. Il arrive dans les 48 heures, et il est à toi.</figcaption>
  </figure>
)}
{type === 'garantie' && (
  <figure class="preuve-cta pc-garantie">
    <span class="pc-bouclier" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 2.5l7.5 3v6c0 4.6-3.2 8.4-7.5 10-4.3-1.6-7.5-5.4-7.5-10v-6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 12.2l2.4 2.4 4.6-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
    <div>
      <p class="pc-g-titre">Chaque système livré est garanti 30 jours, par écrit.</p>
      <p class="pc-g-texte">Si un système ne fait pas ce qui était prévu au contrat, je travaille dessus gratuitement jusqu'à ce qu'il fonctionne. Et si je n'y arrive pas, tu es remboursé au complet pour ce système.</p>
    </div>
  </figure>
)}

<style>
  .preuve-cta { margin: 0 auto 1.6rem; max-width: 34rem; text-align: left; }
  .pc-cadre { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 16px 40px rgba(0,0,0,.45); }
  .pc-clair { background: #fdfbf5; }
  .pc-cadre img { display: block; width: 100%; height: auto; }
  .pc-badge { position: absolute; bottom: .6rem; right: .6rem; font-size: .72rem; font-weight: 700; letter-spacing: .02em; color: #0b0b0c; background: #f3d36b; border-radius: 6px; padding: .22rem .5rem; }
  .preuve-cta figcaption { font-size: .92rem; line-height: 1.5; color: #c9cbc3; margin-top: .7rem; text-align: center; }
  .pc-garantie { display: flex; gap: 1rem; align-items: flex-start; padding: 1.1rem 1.2rem; border-radius: 14px; border: 1px solid rgba(183,217,76,.3); background: rgba(183,217,76,.05); }
  .pc-bouclier { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; background: rgba(183,217,76,.12); color: var(--lime); }
  .pc-bouclier svg { width: 26px; height: 26px; }
  .pc-g-titre { margin: 0 0 .35rem; font-weight: 700; color: #fff; font-size: 1rem; }
  .pc-g-texte { margin: 0; font-size: .9rem; line-height: 1.55; color: #c9cbc3; }
</style>
