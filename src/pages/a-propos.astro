---
// Page « À propos » : définit l'entité FournIA et son fondateur pour Google et les moteurs IA (GEO).
// Ne contient que des faits établis (voir fournia-aios/context/work.md). Aucun client nommé.
import Base from '../layouts/Base.astro';
import { REALISATIONS } from '../data/realisations.mjs';
import Temoignages from '../components/Temoignages.astro';
import { SITE, CTA, ZONES, organisationLd } from '../data/entite.mjs';

const canonical = `${SITE}/a-propos/`;
// « 100+ automatisations » : chiffre donné par Simon le 2026-11-16. Secteurs : tirés de src/data/realisations.mjs.
const nbSecteurs = new Set(REALISATIONS.map((r) => r.secteur)).size;
const title = "À propos de FournIA et de Simon Fournier | FournIA";
const description = "FournIA rend l'IA simple et utile pour les PME du Québec. Fondée en 2026 à Blainville par Simon Fournier : la vision, l'équipe et la façon de travailler.";
const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'fr-CA',
  about: { '@id': `${SITE}/#fournia` },
  mainEntity: { '@id': `${SITE}/#simon-fournier` },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'À propos', item: canonical },
  ],
};
---
<Base title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(aboutLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organisationLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  <main>
    <article class="svc">
      <div class="wrap-a">
        <div class="crumbs"><a href="/">Accueil</a> <span>/</span> À propos</div>

        <div class="intro">
          <div>
            <p class="etiquette">À propos de FournIA</p>
            <h1>On rend l'IA simple et utile pour les PME du Québec.</h1>
            <p class="lead">FournIA installe dans les PME des systèmes qui font les tâches répétitives à leur place, et forme les équipes qui les utilisent. L'entreprise est née en avril 2026 à Blainville, sur la Rive-Nord de Montréal.</p>
            <a class="btn btn-primary" href={CTA}>Réserver le diagnostic gratuit <span class="arrow">→</span></a>
          </div>
          <div class="photo">
            <img src="/images/simon-fournier-portrait-b.webp" alt="Simon Fournier, fondateur de FournIA" width="960" height="1200" fetchpriority="high" />
            <p class="legende"><strong>Simon Fournier</strong><span>Fondateur de FournIA</span></p>
          </div>
        </div>

        <ul class="chiffres">
          <li><strong>100+</strong><span>automatisations construites</span></li>
          <li><strong>{nbSecteurs}</strong><span>secteurs d'activité</span></li>
          <li><strong>Incluse</strong><span>la formation de votre équipe, à chaque livraison</span></li>
        </ul>

        <section class="bloc histoire">
          <p class="etiquette">Notre histoire</p>
          <h2>Tout a commencé par un traiteur qui retapait ses commandes à la main.</h2>
          <div class="deux">
            <p>En avril 2026, Simon Fournier lance FournIA à Blainville. Le premier mandat : un traiteur corporatif de Montréal dont l'équipe passait des heures à retaper les commandes et à monter les offres de service. Une fois le premier système en place, le même client en a demandé un deuxième, puis un troisième.</p>
            <p>Le constat est vite devenu clair : les PME ne manquent pas d'idées pour l'IA, elles manquent de quelqu'un qui l'installe pour vrai, dans leurs outils, et qui forme leur monde. Depuis, l'équipe a construit plus de 100 automatisations dans {nbSecteurs} secteurs, du traiteur à la location d'équipement en passant par les conseillers financiers.</p>
          </div>
        </section>

        <section class="bloc vision">
          <p class="etiquette">Notre vision</p>
          <h2>Devenir la référence en IA pour les PME du Québec.</h2>
          <div class="deux">
            <p>La plupart des propriétaires de PME savent que l'IA va changer leur façon de travailler. Ce qui les retient, c'est de ne pas savoir par où commencer, et la peur de mal faire avec leurs données ou leur équipe.</p>
            <p>Notre travail, c'est d'enlever ce poids : regarder comment l'entreprise fonctionne vraiment, installer ce qui rapporte en premier, et former les gens jusqu'à ce qu'ils soient à l'aise. Une entreprise à la fois, avec des résultats qu'on peut mesurer.</p>
          </div>
        </section>

        <section class="bloc equipe">
          <p class="etiquette">L'équipe</p>
          <h2>Une équipe qui conçoit, construit et forme</h2>
          <div class="cartes">
            <article>
              <h3>Simon Fournier</h3>
              <p class="role">Fondateur</p>
              <p>Il a fondé FournIA et en fixe la direction : la vision, la méthode et le niveau d'exigence de chaque livraison.</p>
            </article>
            <article>
              <h3>Conception et développement</h3>
              <p class="role">L'équipe de construction</p>
              <p>Elle construit les systèmes, les branche sur vos outils et les teste avant la livraison. Chaque projet a un responsable attitré.</p>
            </article>
            <article>
              <h3>Réseau d'affaires</h3>
              <p class="role">Partenaires</p>
              <p>Des agences, des consultants et des entrepreneurs de la région avec qui on travaille et qui nous présentent les PME qu'ils accompagnent.</p>
            </article>
          </div>
        </section>

        <section class="bloc humain">
          <div class="humain-photo">
            <img src="/images/simon-fournier-atelier.webp" alt="Simon Fournier avec une propriétaire de PME" width="960" height="1200" loading="lazy" decoding="async" />
          </div>
          <div>
            <p class="etiquette">En dehors du bureau</p>
            <h2>Qui est Simon</h2>
            <p>Simon habite Blainville. En plus de FournIA, il joue au hockey junior avec les Black Vees de Montréal et étudie à temps partiel à l'Université Concordia, en économie et en finance.</p>
            <p>En août 2026, il a couru 100 km pour le 100KM d'Espoir, au profit de Leucan. Vingt boucles de 5 km, une à l'heure, jusqu'au bout.</p>
            <p class="citation">« Le hockey et la course m'ont appris la même chose que les projets : on se prépare, on fait sa part pour l'équipe, et on finit ce qu'on commence. »</p>
          </div>
        </section>

        <div class="prose">
          <h2>Ce que fait FournIA</h2>
          <ul>
            <li><strong><a href="/automatisation-entreprise/">Systèmes à la carte</a></strong> : un problème précis (relances, soumissions, demandes entrantes, commandes), un système branché sur vos logiciels actuels.</li>
            <li><strong><a href="/accompagnement-intelligence-artificielle/">Accompagnement complet</a></strong> : toute l'entreprise, du diagnostic au suivi, sur 6 mois à 1 an.</li>
            <li><strong><a href="/formation-ia-entreprise/">Formation IA en entreprise</a></strong> : l'équipe apprend à utiliser l'IA sur ses vraies tâches.</li>
          </ul>

          <h2>Comment on travaille</h2>
          <ul>
            <li><strong>Le diagnostic d'abord.</strong> On mesure le temps que prend chaque étape du processus. Ce chiffre décide de ce qu'on automatise en premier.</li>
            <li><strong>L'implantation et la formation vont ensemble.</strong> Chaque système livré vient avec la formation de l'équipe qui l'utilise.</li>
            <li><strong>La Loi 25 à chaque projet.</strong> Un projet qui touche des renseignements personnels passe une vérification écrite avant la construction.</li>
          </ul>

          <h2>Où FournIA intervient</h2>
          <p>En personne à {ZONES.join(', ')}. Ailleurs au Québec, par visioconférence.</p>

          <h2>Pour joindre FournIA</h2>
          <p>Courriel : <a href="mailto:s.fournier@fournia.net">s.fournier@fournia.net</a> · Téléphone : <a href="tel:+15148632973">514 863 2973</a> · <a href="https://www.linkedin.com/in/simon-fournier-432a95419/" target="_blank" rel="noopener">Simon Fournier sur LinkedIn</a></p>
        </div>
      </div>

      <Temoignages />

      <div class="wrap-a">
        <div class="post-cta">
          <h3>Une tâche vous coûte des heures chaque semaine ?</h3>
          <p>Commencez par un diagnostic gratuit de 30 minutes.</p>
          <a class="btn btn-primary" href={CTA}>Réserver le diagnostic <span class="arrow">→</span></a>
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  main { position: relative; z-index: 1; }
  .svc { padding: 8.5rem 0 4rem; }
  .wrap-a { width: min(1100px, 92vw); margin: 0 auto; }
  .crumbs { font-size: .85rem; color: var(--mute); margin-bottom: 1.4rem; }
  .crumbs a:hover { color: var(--lime); }
  .crumbs span { margin: 0 .4rem; }
  .etiquette { color: var(--lime); font-family: 'Space Grotesk', sans-serif; font-size: .92rem; font-weight: 500; margin-bottom: 1rem; }
  .intro { display: grid; grid-template-columns: 1.15fr .85fr; gap: 4rem; align-items: center; }
  .photo img { width: 100%; height: auto; border-radius: 22px; display: block; border: 1px solid var(--line); }
  .chiffres { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 4rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .chiffres li { padding: 1.8rem 1.4rem; display: flex; flex-direction: column; gap: .3rem; }
  .chiffres li + li { border-left: 1px solid var(--line); }
  .chiffres strong { font-family: 'Space Grotesk', sans-serif; font-size: 2.6rem; font-weight: 600; color: var(--white); letter-spacing: -.03em; line-height: 1; }
  .chiffres span { color: var(--mute); font-size: .95rem; }
  .bloc { margin-top: 5.5rem; }
  .bloc h2 { font-family: 'Space Grotesk', sans-serif; color: var(--white); font-size: clamp(1.8rem, 3.6vw, 2.6rem); line-height: 1.1; letter-spacing: -.03em; font-weight: 600; max-width: 22ch; margin-bottom: 1.6rem; }
  .bloc p { color: var(--mute); font-size: 1.06rem; line-height: 1.75; }
  .bloc p.etiquette { color: var(--lime); font-size: .92rem; line-height: 1.4; margin-bottom: 1rem; }
  .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .cartes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .cartes article { padding: 1.7rem; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,.02); }
  .cartes h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 500; color: var(--white); }
  .cartes .role { color: var(--lime); font-size: .88rem; margin: .2rem 0 .9rem; }
  .cartes p:not(.role) { font-size: .98rem; line-height: 1.65; }
  .humain { display: grid; grid-template-columns: .8fr 1.2fr; gap: 4rem; align-items: center; }
  .humain-photo img { width: 100%; height: auto; border-radius: 22px; display: block; border: 1px solid var(--line); }
  .humain p + p { margin-top: 1rem; }
  .citation { color: var(--white) !important; font-family: 'Space Grotesk', sans-serif; font-size: 1.2rem !important; line-height: 1.5 !important; border-left: 2px solid var(--lime); padding-left: 1.1rem; margin-top: 1.8rem !important; }
  .svc h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.05; letter-spacing: -.035em; font-weight: 600; margin-bottom: 1.2rem; }
  .lead { color: var(--mute); font-size: 1.15rem; line-height: 1.65; margin-bottom: 1.8rem; max-width: 36rem; }
  .photo { width: 100%; }
  .legende { margin-top: .9rem; display: flex; flex-direction: column; }
  .legende strong { font-family: 'Space Grotesk', sans-serif; font-size: 1.05rem; }
  .legende span { color: var(--mute); font-size: .9rem; }
  .prose { color: var(--mute); font-size: 1.06rem; line-height: 1.75; margin-top: 3.5rem; max-width: 46rem; }
  .prose :global(h2) { font-family: 'Space Grotesk', sans-serif; color: var(--white); font-size: 1.6rem; line-height: 1.2; letter-spacing: -.01em; margin: 2.4rem 0 .9rem; }
  .prose :global(p) { margin-bottom: 1.1rem; }
  .prose :global(ul) { margin: 0 0 1.2rem 1.3rem; }
  .prose :global(li) { margin-bottom: .5rem; }
  .prose :global(a) { color: var(--lime); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: rgba(183,217,76,.4); }
  .prose :global(strong) { color: var(--white); font-weight: 600; }
  .post-cta { margin-top: 3.5rem; padding: 2.2rem; border-radius: 22px; background: linear-gradient(160deg, rgba(183,217,76,.10), rgba(20,20,20,.55)); border: 1px solid var(--glass-b); }
  .post-cta h3 { font-size: 1.4rem; margin-bottom: .6rem; color: var(--white); }
  .post-cta p { color: var(--mute); margin-bottom: 1.4rem; }
  @media (max-width: 760px) {
    .intro, .deux, .cartes, .humain { grid-template-columns: 1fr; gap: 2rem; }
    .photo { max-width: 320px; }
    .chiffres { grid-template-columns: 1fr; }
    .chiffres li + li { border-left: none; border-top: 1px solid var(--line); }
  }
</style>
