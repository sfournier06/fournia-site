];

const exigences = [
  'Une personne qui conçoit tes systèmes et que tu peux joindre, du début à la fin.',
  'Un document Loi 25 écrit pour chaque système qui touche des renseignements personnels.',
  'La formation de ton équipe à chaque livraison.',
  "Le droit d'approuver un message avant qu'il parte.",
  'Une garantie écrite, avec ses conditions.',
];

const logosClients = [
  { src: '/clients/mini/avecplaisirs.webp' },
  { src: '/clients/mini/pubsphere.webp' },
  { src: '/clients/mini/arbour.webp' },
  { src: '/clients/mini/seniortech.webp' },
];

const murLogos = [
  { nom: 'AvecPlaisirs', src: '/clients/mono/avecplaisirs.webp', l: 320, h: 101 },
  { nom: 'Pubsphere', src: '/clients/mono/pubsphere.webp', l: 276, h: 44 },
  { nom: 'Arbour Aide Académique', src: '/clients/mono/arbour.webp', l: 320, h: 148 },
  { nom: 'SeniorTech', src: '/clients/mono/seniortech.webp', l: 320, h: 82 },
];

const bonus = [
  { t: 'Ton dossier Loi 25, écrit', d: "Pour chaque système qu'on bâtit, un document dit quelles données il touche, où elles vont et qui y a accès. Si un client te demande où vont ses données, la réponse est écrite pour ce système.", petit: "Ce document décrit les systèmes qu'on bâtit. Il ne remplace pas l'avis d'un juriste." },
  { t: "La politique d'usage de l'IA de ton équipe", d: "Une page claire : ce que ton équipe peut faire avec l'IA, ce qu'elle ne fait jamais (par exemple coller les données d'un client dans un outil public), et à qui demander en cas de doute. Prête à afficher." },
  { t: "L'aide-mémoire de demandes prêtes à l'emploi", d: 'Les demandes à copier-coller pour les tâches de ton équipe : courriels, soumissions, résumés. Écrites pour ton métier, utilisables dès le premier jour.' },
];

const faq = [
  { q: "Mon équipe ne connaît rien à l'IA. Est-ce un problème ?", a: ["Non. L'accompagnement existe pour ça. On explique en mots simples comment l'IA fonctionne, ce qu'elle fait bien et ce qu'elle fait mal, avant de toucher à tes outils. Personne n'a besoin de connaissances techniques au départ."] },
  { q: 'Comment se passent les 30 minutes du diagnostic ?', a: ["Tu me racontes comment une demande passe chez vous, du premier appel jusqu'à la facture. Je te pose des questions précises sur le temps que prend chaque étape. Dans les 48 heures, tu reçois ton diagnostic écrit. Si tu veux aller plus loin ensuite, on te présente l'accompagnement dans une autre rencontre."] },
  { q: 'Combien de temps dure un accompagnement complet ?', a: ["Ça dépend de la taille de l'entreprise et du nombre de processus à revoir. Le plan du début fixe l'ordre des chantiers et la durée prévue."] },
  { q: 'Est-ce que je m\'engage pour longtemps ?', a: ["Le diagnostic ne t'engage à rien. Pour l'accompagnement, la durée minimale est écrite au contrat, et on te la présente avec ton plan, avant que tu signes."], revue: 'à trancher : écrire ou non la durée minimale' },
  { q: 'Est-ce que je dois changer de logiciels ?', a: ["En général, non. On part des outils que tu utilises déjà. On propose un nouvel outil seulement quand le tien ne peut pas faire le lien."] },
  { q: 'À qui appartiennent les systèmes ?', a: ["Tes données restent à toi. Pour chaque système, ton dossier écrit nomme les comptes et les services qu'il utilise, et à qui ils appartiennent."], revue: 'à confirmer par Simon' },
  { q: 'Est-ce que des messages vont partir à mes clients sans que je le sache ?', a: ["Seulement si tu le décides. Pour chaque système, tu choisis quels messages partent seuls et lesquels tu approuves avant l'envoi. Tu peux changer d'idée quand tu veux."] },
  { q: "L'accompagnement se fait-il en personne ?", a: ['En personne ou à distance. Les rencontres se font en personne sur la Rive-Nord de Montréal, à Laval et à Montréal, ou par visioconférence partout au Québec.'] },
  { q: 'Comment FournIA respecte-t-elle la Loi 25 ?', a: ["Chaque projet qui touche des renseignements personnels passe par une vérification Loi 25 avant la construction, avec une attention particulière au transfert de données hors Québec quand un modèle d'IA est utilisé. Tu reçois un document écrit : quelles données le système touche, où elles vont et qui y a accès."], petit: "Ce document décrit les systèmes qu'on bâtit. Il ne remplace pas l'avis d'un juriste." },
  { q: "Pourquoi le prix n'est pas sur la page ?", a: ["Chaque accompagnement suit un plan différent : le nombre de chantiers, tes outils, la taille de ton équipe. On te présente le prix en personne, avec ce plan devant toi. Le diagnostic, lui, est gratuit."] },
];

// Les 16 objections : questions dans la voix du prospect, réponses en paragraphes courts.
const objections = [
  { q: '« C\'est trop cher pour une PME. »', a: ["On commence par un seul chantier : celui qui te coûte le plus, mesuré au diagnostic.", "Le prix dépend de ton plan. On te le présente en personne, avec ce plan devant toi, et seulement si tu veux aller plus loin.", 'Et si un seul système suffit chez vous, on te le dit.'], revue: 'à trancher : ajouter la phrase sur les subventions' },
  { q: "« Je n'ai pas le temps pour ça. »", a: ['De ton côté, au total : 30 minutes pour le diagnostic. Deux rencontres d\'environ une heure pour démarrer. Ensuite, une rencontre aux deux semaines.', 'Le reste est notre travail : bâtir, tester, installer, former.', 'Ton calendrier est plein ce mois-ci ? Fais le diagnostic maintenant. Ton plan écrit sera prêt le jour où tu voudras commencer.'] },
  { q: '« Mon équipe va avoir peur. »', a: ["On le prévoit dès le départ. Ton équipe teste chaque système avec nous avant qu'il roule. On la forme à chaque livraison, en mots simples : ce que l'IA fait bien, ce qu'elle fait mal, et quoi faire quand elle se trompe.", "La politique d'usage de l'IA dit clairement ce qui est permis. Et les messages importants passent par une personne avant de partir, aussi longtemps que tu le veux."] },
  { q: "« J'ai déjà essayé un outil. Ça n'a pas marché. »", a: ["Chez les PME que je rencontre, un outil installé sans regarder comment l'équipe travaille finit souvent par dormir. On fait l'étape d'avant : on suit ton travail d'une étape à l'autre, puis on choisit.", "Si l'outil que tu paies déjà peut faire le travail, on part de lui. On en propose un nouveau seulement quand le tien ne peut pas."] },
  { q: '« Mes données vont aller où ? »', citation: { t: '« […] Je suis un peu parano sur ça. »', qui: 'Un gestionnaire, en rencontre' }, a: ['Tu as raison de poser la question. Avant de bâtir un système qui touche des renseignements personnels, on passe une vérification Loi 25. Tu reçois un document écrit : quelles données le système touche, où elles vont, et qui y a accès.', "On porte une attention particulière aux données qui sortiraient du Québec quand un modèle d'IA est utilisé."] },
  { q: '« Je peux le faire moi-même avec ChatGPT. »', a: ['Pour une partie, oui. Ton diagnostic écrit te dit même ce que tu peux faire toi-même, sans nous.', "ChatGPT répond quand tu lui écris. Un système part seul quand une demande arrive : il relance à la bonne date et range l'information au bon endroit, même quand tu es sur un chantier.", 'Reste à savoir qui va le bâtir, le tester et le garder à jour. Si c\'est toi, ça se fera le soir.'] },
  { q: "« Ce n'est pas pour une entreprise de ma taille. »", a: ["C'est à ça que sert le diagnostic. On mesure tes tâches en heures par mois. Si un seul système suffit chez vous, on te le dit, et on te bâtit celui-là, sans rien te vendre de plus. Si l'automatisation ne vaut pas la peine chez vous, on te le dit aussi."] },
  { q: '« Je ne suis pas techno. »', citation: { t: '« Ben honnêtement, je comprends pas comment ces choses-là fonctionnent. »', qui: 'Propriétaire, plusieurs entreprises de services' }, a: ["Tu n'as pas besoin de l'être. Ton travail, c'est de nous expliquer comment une demande passe chez vous. Le nôtre, c'est de bâtir, tester et installer.", "À chaque livraison, on t'explique le système en mots simples et on forme ton équipe. Tu sais ce qu'il fait, quand il le fait, et quoi faire s'il se trompe."] },
  { q: '« Mon dernier fournisseur n\'était jamais disponible. »', citation: { t: "« […] il me dit tout le temps qu'il est pas disponible, qu'il est en voyage ou que quelque chose d'autre à faire. »", qui: 'Propriétaire, plusieurs entreprises de services' }, a: ['Tu as un seul interlocuteur, du début à la fin : la personne qui conçoit tes systèmes.', "La rencontre aux deux semaines est fixée d'avance. Après chaque rencontre, tu reçois la prochaine étape par écrit, avec une date.", 'Nos équipes nous limitent à 3 accompagnements par mois, pour bien livrer chacun.'], revue: "à confirmer par Simon : rencontre fixée d'avance + prochaine étape écrite et datée après chaque rencontre (aucune SOP ni contrat ne le prévoit)" },
  { q: '« Mes clients vont trouver ça robotisé. »', a: ['Les messages sont écrits avec toi, dans tes mots, et ils partent à ton nom.', "Tu choisis lesquels partent seuls et lesquels passent par toi avant l'envoi. Au début, tu peux tout approuver. Tu laisses partir seuls ceux qui te ressemblent, quand tu es prêt."] },
  { q: '« L\'IA va remplacer mon équipe. »', a: ['On automatise des tâches précises : recopier, relancer, classer. Les décisions et les cas délicats restent à ton équipe.', 'Ton équipe teste chaque système avec nous, et elle est formée à chaque livraison. Elle sait ce que le système fait, et quand reprendre la main.'] },
  { q: '« Si on touche à ce qui marche, tout va casser. »', a: ["Ton équipe teste chaque système avec nous avant qu'il roule pour vrai.", "Et chaque système livré est garanti 30 jours : si un bogue l'empêche de faire ce qui était prévu au contrat, on le corrige sans frais."] },
  { q: '« Je ne veux pas un abonnement de plus. »', a: ["Côté logiciels, on part de ceux que tu paies déjà. Un nouvel outil s'ajoute seulement quand le tien ne peut pas faire le lien, et jamais sans ton accord écrit.", "L'accompagnement comprend un montant mensuel. On te le présente en personne, avec ton plan et la durée minimale, avant que tu signes."], revue: "à confirmer : accord écrit avant tout outil ajouté (précédent Son'OR : Muse annoncé par texto avant la dépense) ; dire ou non le montant mensuel" },
  { q: '« Chez nous, chaque cas est différent. »', a: ["Les cas spéciaux restent à toi. On automatise la partie qui se répète d'une demande à l'autre : la réception, le classement, la relance, la saisie.", "Ce qui sort de l'ordinaire passe par une personne. C'est toi qui fixes la règle."] },
  { q: '« Je dois en parler à mon associé. »', a: ['Invite-le au diagnostic. En 30 minutes, vous voyez tous les deux vos 3 fuites, et le plan écrit arrive dans les 48 heures.', "S'il ne peut pas être là, tu lui transmets ton plan écrit tel quel."] },
  { q: "« Je n'y crois pas trop. »", a: ["Tu n'as pas à nous croire sur parole. Le diagnostic est gratuit, sans engagement, et tu gardes ton plan écrit même si on ne travaille jamais ensemble.", 'Si tu vas plus loin, on commence par un seul chantier, et chaque système livré est garanti 30 jours.'] },
];

const delai = '<span class="pastille">[délai : 14 ou 30 jours, à trancher]</span>';
// Mécanisme nommé (proposé le 2026-11-20, à confirmer par Simon) : change ici, partout d'un coup.
const mecanisme = '<strong>la méthode des 3 fuites</strong>';

const etoile = '<path d="M10 1.6l2.47 5.3 5.8.68-4.3 3.96 1.15 5.73L10 14.4l-5.12 2.87 1.15-5.73-4.3-3.96 5.8-.68z"/>';
const etoiles = '<svg class="etoiles" viewBox="0 0 100 20" aria-hidden="true">' + [0, 1, 2, 3, 4].map((i) => '<g transform="translate(' + i * 20 + ' 0)">' + etoile + '</g>').join('') + '</svg>';
const coche = '<svg class="coche" viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const croix = '<svg class="croix" viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
---
<Base title="Accompagnement complet en automatisation | FournIA" description="On sort les tâches répétitives de ta semaine, un chantier à la fois, dans tes outils actuels. Diagnostic gratuit de 30 minutes." canonical="https://fournia.net/accompagnement-complet/" minimal>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <link slot="head" rel="preload" href="/images/simon-fournier-flou.webp" as="image" fetchpriority="high" />
  <link slot="head" rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />

  <main class="lp">
    <!-- Au-dessus du pli : étapes 1 à 3, bouton, preuve. Sans animation (LCP). -->
    <header class="hero">
      <div class="hero-fond" aria-hidden="true"><img src="/images/simon-fournier-flou.webp" alt="" width="480" height="600" fetchpriority="high" /></div>
      <div class="hero-contenu">
        <!-- Étape 1 : la preuve d'abord, puis la personne visée -->
        <div class="preuve-barre">
          <span class="preuve-note"><span class="etoiles-w" set:html={etoiles}></span><span><strong>5,0</strong> sur Google</span><span class="pastille">[N] avis · à vérifier</span></span>
          <span class="logos" role="img" aria-label="Ils nous font confiance : AvecPlaisirs, Pubsphere, Arbour Aide Académique, SeniorTech">
            {logosClients.map((l) => <span class="logo-rond"><img src={l.src} alt="" width="40" height="40" decoding="async" /></span>)}
          </span>
        </div>
        <p class="interpelle">Propriétaire d'une PME de services au Québec : tes appels, tes soumissions et tes relances passent encore tous par toi&nbsp;? <span class="pastille">à trancher</span></p>

        <!-- Étape 2 : la grosse promesse (titre définitif à trancher par Simon) -->
        <h1 class="titre-geant" id="titre-angle">Récupère <em>tes soirées</em></h1>
        <script is:inline>
          // Message match : chaque pub envoie ?angle=<nom> et la page reprend sa promesse. Sans paramètre
          // (ou inconnu), le titre par défaut reste. Liste et règles : fournia-aios marketing/publicites/meta/setup-campagne-v2.md
          (function () {
            var t = {
              soirees: 'Récupère <em>tes soirées</em>',
              outils: "Moins d'admin, <em>sans changer d'outils</em>",
              'appel-manque': 'Tes appels manqués reçoivent <em>une réponse</em>',
              soumission: 'Tes soumissions relancées <em>au bon moment</em>',
              relances: 'Tes relances partent <em>à temps</em>',
              methode: "Pourquoi ton outil d'IA <em>dort</em>"
            };
            try {
              var a = new URLSearchParams(location.search).get('angle');
              var h = document.getElementById('titre-angle');
              if (a && t[a] && h) { h.innerHTML = t[a]; if (a !== 'soirees') h.classList.add('titre-long'); }
            } catch (e) {}
          })();
        </script>

        <!-- Étape 3 : sous-titre, ouvrir une boucle -->
        <p class="sous-titre st-long">En 30 minutes, on trouve les 3 fuites qui te coûtent le plus de temps. Dans les 48 heures, tu reçois ton plan écrit pour les boucher, dans les outils que tu as déjà. C'est gratuit. Et il y a une raison précise pour laquelle ton dernier outil dort.</p>
        <!-- Mobile : même promesse, plus courte, pour que la vignette du VSL arrive plus haut -->
        <p class="sous-titre st-court">En 30 minutes, on trouve tes 3 fuites. Ton plan écrit arrive en 48 heures, gratuit. Et ton dernier outil dort pour une raison précise.</p>

        <!-- Le VSL, dans le haut de page (événement d'optimisation Meta : VSL vu à 50 %). Le bouton est juste dessous. -->
        <div class="hero-vsl"><VslPlayer /></div>

        <a class="btn btn-primary btn-cta btn-geant" href={CTA} data-cta-haut>{ctaTexte} <span class="arrow">→</span></a>
        <p class="note-cta"><span class="etoiles-w" set:html={etoiles}></span><span class="pastille">5,0 · à vérifier</span> sur Google · <span class="pastille">[N] avis · à vérifier</span></p>
        <p class="mini-cta">Ton plan écrit en 48&nbsp;h · sans engagement</p>
        <p class="rarete-cta">Nos équipes nous limitent à 3&nbsp;accompagnements par mois.</p>

        <!-- Mur de logos : seulement les logos déjà affichés sur le site (bandeau des réalisations), version blanche -->
        <div class="mur-logos">
          <p class="mur-titre">Des entreprises du Québec qui nous font confiance</p>
          <ul class="mur-grille">
            {murLogos.map((l) => <li><img src={l.src} alt={l.nom} width={l.l} height={l.h} loading="lazy" decoding="async" /></li>)}
          </ul>
          <p class="mur-note"><span class="pastille">accord de chaque client à confirmer</span></p>
        </div>
      </div>
    </header>

    <!-- Étape 4 : l'intrigue -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Pourquoi ton dernier outil dort</h2>
        <p class="grand">Tu as peut-être déjà acheté un outil. Peut-être même payé quelqu'un pour l'installer.</p>
        <p class="grand">Trois semaines plus tard, l'outil dormait. Et tu étais revenu à tes vieilles habitudes.</p>
        <p>Il manquait une étape. D'après ce que je vois chez les PME que je rencontre, presque personne ne la fait avant d'installer un outil.</p>
        <p>On te la montre plus bas.</p>
      </div>
    </section>

    <!-- Étape 5 : le problème -->
    <section class="bloc bloc-alt">
      <div class="col reveal">
        <h2>Les appels, les soumissions et les relances reposent encore sur toi</h2>
        <ul class="scenes">
          <li>Ton téléphone sonne pendant que tu es sur un chantier. Le client tombe sur ta boîte vocale. Il appelle le suivant sur la liste.</li>
          <li>Ta soumission dort depuis cinq jours. Personne ne l'a relancée.</li>
          <li>Le soir, tu recopies dans un logiciel ce que tu as déjà écrit dans un autre.</li>
          <li>Tes courriels attendent le seul matin libre de ta semaine.</li>
          <li>Tes anciens clients te connaissent déjà. Tu te dis que tu vas les rappeler. Tu ne les rappelles pas.</li>
        </ul>
        <p class="grand chute">Mises ensemble, ces tâches prennent tes soirées.</p>
        <h3 class="h3-mots">Dans les mots de gens d'affaires qu'on a rencontrés</h3>
        <div class="citations">
          <blockquote><p>« J'ai perdu beaucoup de contrats de service parce que ils me montrent comme si tous mes messages ont été lus. »</p><cite>Propriétaire, plusieurs entreprises de services</cite></blockquote>
          <blockquote><p>« Mais en ce moment, ce qui me gruge mon temps, c'est la paperasse avec les autres agents. »</p><cite>Conseiller financier, chef d'équipe</cite></blockquote>
          <blockquote><p>« Je veux pas en échapper une […] »</p><cite>Propriétaire, plusieurs entreprises de services</cite></blockquote>
        </div>
      </div>
    </section>

    <!-- Étape 6 : la solution, le mécanisme nommé (ses 2 premières étapes = l'appel gratuit) -->
    <section class="bloc">
      <div class="col reveal">
        <h2>La méthode des 3 fuites : on trouve où ton temps s'échappe, avant de choisir l'outil</h2>
