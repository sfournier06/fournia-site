const benefices = [
  'Les appels manqués reçoivent une réponse, même quand tu es sur un chantier.',
  'Tes soumissions sont relancées au bon moment, sans que tu y penses.',
  "Tu ne recopies plus la même information d'un logiciel à l'autre.",
  'Chaque nouvelle demande arrive au même endroit, classée : nouvelle, ou déjà entamée.',
  'Tes anciens clients entendent parler de toi. Tu approuves avant que ça parte.',
  "Ton équipe sait se servir de l'IA, et sait où elle se trompe.",
  "Tu gardes les décisions. L'IA prépare. Toi, tu décides.",
];

const offre = [
  'Le diagnostic de ton entreprise et un plan priorisé.',
  'Les systèmes bâtis, testés et installés dans tes outils actuels, un chantier à la fois.',
  'La formation de ton équipe à chaque livraison.',
  'Une rencontre aux deux semaines, en personne ou en visio.',
  'Un seul interlocuteur, du début à la fin.',
  'Les ajustements quand tes besoins changent, et un bilan de ce qui a été gagné.',
];

const pourQui = [
  'Tu diriges une PME de services au Québec, avec une équipe.',
  'Les mêmes tâches reviennent chaque semaine : appels, soumissions, relances, saisie.',
  "Tu sais ce qu'il faudrait faire. C'est le temps qui manque.",
  'Tu prends les décisions, ou la personne qui les prend sera au diagnostic.',
  'Tu peux donner une rencontre aux deux semaines.',
];
const pasPourQui = [
  'Tu cherches un outil à brancher ce soir, sans regarder comment ton équipe travaille.',
  "Tu veux tout automatiser d'un coup, en une semaine.",
  'Tu veux qu\'on te garantisse un chiffre de ventes. Notre garantie porte sur une chose : chaque système livré fait ce qui est prévu au contrat.',
  "L'IA t'intéresse par curiosité, sans tâche précise qui te coûte du temps.",
  'Tu travailles seul, sans employés. Un système précis te servira mieux qu\'un accompagnement complet.',
];

const rencontre = [
  { t: 'Ce qui a avancé.', d: "On te le montre à l'écran, en fonctionnement." },
  { t: 'Ce qui accroche.', d: "Ce que ton équipe a remarqué, et ce qu'on corrige." },
  { t: "Ce qu'on a besoin que tu décides.", d: 'Par exemple : quels messages partent seuls, et lesquels passent par toi.' },
