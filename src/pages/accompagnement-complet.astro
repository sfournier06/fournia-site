const icDoc = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3v4h4M10 12h5M10 16h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
const icHorloge = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
const icLieu = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0113 0c0 5-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>';
const etoile = '<path d="M10 1.6l2.47 5.3 5.8.68-4.3 3.96 1.15 5.73L10 14.4l-5.12 2.87 1.15-5.73-4.3-3.96 5.8-.68z"/>';
const etoiles = '<svg class="etoiles" viewBox="0 0 100 20" aria-hidden="true">' + [0, 1, 2, 3, 4].map((i) => '<g transform="translate(' + i * 20 + ' 0)">' + etoile + '</g>').join('') + '</svg>';
const coche = '<svg class="coche" viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const croix = '<svg class="croix" viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
---
<Base title="Accompagnement complet en automatisation | FournIA" description="On sort les tâches répétitives de ta semaine, un chantier à la fois, dans tes outils actuels. Diagnostic gratuit de 30 minutes." canonical="https://fournia.net/accompagnement-complet/" minimal>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <link slot="head" rel="preload" href="/images/simon-fournier-flou.webp" as="image" fetchpriority="high" />
  <link slot="head" rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
  {VSL_PRET && (
  <>
  <!-- Le plus gros élément du haut de page sur mobile : la vignette du VSL. Préchargée en priorité. -->
  <link slot="head" rel="preload" as="image" href="/images/vsl-vignette-960.webp" imagesrcset="/images/vsl-vignette-640.webp 640w, /images/vsl-vignette-960.webp 960w" imagesizes="(max-width: 560px) 92vw, 820px" fetchpriority="high" />
  </>
  )}

  <main class="lp">
    <!-- Au-dessus du pli : étapes 1 à 3, bouton, preuve. Sans animation (LCP). -->
    <header class="hero">
      <div class="hero-fond" aria-hidden="true"><img src="/images/simon-fournier-flou.webp" alt="" width="480" height="600" fetchpriority="high" /></div>
      <div class="hero-contenu">
        <!-- Étape 1 : la preuve d'abord, puis la personne visée -->
        <div class="preuve-barre">
          <span class="preuve-note"><span class="etoiles-w" set:html={etoiles}></span><span><strong>5,0</strong> sur Google · 5 avis</span></span>
          <span class="client-logo" role="img" aria-label="Clients : AvecPlaisirs, Pubsphere, Arbour Aide Académique, SeniorTech">
            <span class="logos">{['avecplaisirs', 'pubsphere', 'arbour', 'seniortech'].map((n) => <span class="logo-rond"><img src={`/clients/mini/${n}.webp`} alt="" width="40" height="40" decoding="async" /></span>)}</span>
            <span>Ils nous font confiance</span>
          </span>
        </div>
        <p class="interpelle">Propriétaire d'une PME de services au Québec : tes appels, tes soumissions et tes relances passent encore tous par toi&nbsp;?</p>

        <!-- Étape 2 : la grosse promesse (le titre change selon l'angle de la pub, ?angle=) -->
        <h1 class="titre-geant titre-long" id="titre-angle">Gagne <em>5&nbsp;à&nbsp;20&nbsp;heures</em> par&nbsp;semaine<span class="h1-suite">sans embaucher, en 30 jours</span></h1>
        <script is:inline>
          // Message match : chaque pub envoie ?angle=<nom> et la page reprend sa promesse. Sans paramètre
          // (ou inconnu), le titre par défaut reste. Liste et règles : fournia-aios marketing/publicites/meta/setup-campagne-v2.md
          (function () {
            var t = {
              soirees: 'Récupère <em>tes soirées</em>',
              outils: "Moins d'admin, <em>sans changer d'outils</em>",
              'appel-manque': 'Chaque demande reçoit <em>une réponse</em>',
              soumission: 'Tes soumissions relancées <em>au bon moment</em>',
              relances: 'Tes relances partent <em>à temps</em>',
              methode: "Pourquoi ton outil d'IA <em>dort</em>"
            };
            try {
              var a = new URLSearchParams(location.search).get('angle');
              var h = document.getElementById('titre-angle');
              if (a && t[a] && h) { h.innerHTML = t[a]; h.classList.toggle('titre-long', a !== 'soirees'); }
            } catch (e) {}
          })();
        </script>

        <!-- Étape 3 : sous-titre, ouvrir une boucle -->
        <p class="sous-titre">On automatise les tâches qui reviennent chaque semaine, en partant de tes outils. {VSL_PRET && "Regarde d'abord l'étape que presque personne ne fait."}</p>

        <!-- Le VSL, dans le haut de page (événement d'optimisation Meta : VSL vu à 50 %). Le bouton est juste dessous. -->
        {VSL_PRET && <div class="hero-vsl"><VslPlayer /></div>}

        <a data-cta="1" class="btn btn-primary btn-cta btn-geant" href={CTA} data-cta-haut>{ctaTexte} <span class="arrow">→</span></a>
        <ul class="badges-confiance" aria-label="Nos engagements">
          <li><span set:html={icBouclier}></span>Ça fonctionne, sinon remboursé</li>
          <li><span set:html={icDoc}></span>Dossier Loi&nbsp;25 écrit</li>
          <li><span set:html={icHorloge}></span>Plan écrit en 48&nbsp;h, sans engagement</li>
          <li><span set:html={icLieu}></span>Basé à Blainville, Québec</li>
        </ul>
        <p class="rarete-cta">Nos équipes nous limitent à 3&nbsp;accompagnements par mois.</p>

      </div>
    </header>

    <!-- Étapes 4 et 5 : l'intrigue et le problème -->
    <section id="s-le-probleme" class="bloc">
      <div class="col reveal">
        <p class="etiquette-lp">Le problème</p>
        <h2>Pourquoi ton dernier outil dort</h2>
        <p class="grand">Tu as peut-être déjà acheté un outil, ou payé quelqu'un pour l'installer. Trois semaines plus tard, il dormait.</p>
        <ul class="fuites-liste">
          <li>La soumission qui dort depuis cinq jours</li>
          <li>La demande qui attend pendant que tu es chez un client</li>
          <li>L'information retapée d'un logiciel à l'autre</li>
          <li>Les anciens clients que tu ne rappelles jamais</li>
        </ul>
        <p class="grand chute">Mises ensemble, ces tâches prennent tes soirées. Et il manquait une étape avant l'outil.</p>
      </div>
    </section>

    <!-- Étape 10 de Suby, partie 1 : ce que tu as déjà essayé -->
    <section id="s-deja-essaye" class="bloc bloc-alt">
      <div class="col-large reveal">
        <p class="etiquette-lp">Ce que tu as déjà essayé</p>
        <h2>Chaque solution promettait du temps. Il manquait chaque fois la même étape.</h2>
        <ul class="essais-mini">
          {ceQuiAManque.map((r) => <li><strong>{r.t}</strong><span>{r.manque}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Étape 10 de Suby, partie 2 : avec ou sans le système (visuel, comme la démo de l'accueil) -->
    <section id="s-avec-sans" class="bloc">
      <div class="col-xl reveal">
        <p class="etiquette-lp">Avec ou sans le système</p>
        <h2>Trois tâches, vues des deux côtés</h2>
        <p class="note-scenes">Scènes types, noms fictifs.</p>
        <DemoAvecSans />
      </div>
    </section>

    <!-- Étape 6 : la solution, le mécanisme nommé (ses 2 premières étapes = l'appel gratuit) -->
    <section id="s-la-methode" class="bloc bloc-alt">
      <div class="col reveal">
        <p class="etiquette-lp">Le mécanisme</p>
        <h2>La méthode des 3 fuites</h2>
        <p class="grand">Une fuite, c'est un endroit où ton temps ou tes clients s'échappent chaque semaine. On trouve tes 3 plus grosses, on les chiffre, et on bouche la plus chère d'abord.</p>
        <ol class="etapes etapes-mecanisme">
          <li><strong>Trouver tes 3 fuites.</strong> 30 minutes d'appel : tu me racontes comment une demande passe chez vous.</li>
          <li><strong>Les chiffrer.</strong> Ton diagnostic écrit en 48 heures : chaque fuite en heures par mois, et l'ordre pour les boucher.</li>
          <li><strong>Boucher la plus chère.</strong> Le système bâti en partant de tes outils, testé avec ton équipe, et ton équipe formée.</li>
          <li><strong>Passer à la suivante.</strong> Un bilan de ce qui a été gagné, et une rencontre aux deux semaines.</li>
        </ol>
        <div class="encart-gratuit">
          <p><strong>Les étapes 1 et 2 sont gratuites.</strong> Tu gardes ton plan écrit, même si on ne travaille jamais ensemble.</p>
          <a data-cta="2" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Étape 6a : pour qui, pas pour qui -->
    <section id="s-pour-qui-pas-pour-qui" class="bloc">
      <div class="col-large reveal">
        <p class="etiquette-lp">Pour qui</p>
        <h2>Fait pour les PME de services qui débordent</h2>
        <div class="pour-qui">
          <div class="pq-carte pq-oui">
            <h3>C'est pour toi si :</h3>
            <ul class="liste-coches">
              {pourQui.map((x) => <li><span set:html={coche}></span><span>{x}</span></li>)}
            </ul>
          </div>
          <div class="pq-carte pq-non">
            <h3>Ce n'est pas pour toi si…</h3>
            <ul class="liste-non">
              {pasPourQui.map((x) => <li><span set:html={croix}></span><span>{x}</span></li>)}
            </ul>
          </div>
        </div>
        <div class="centre">
          <p class="grand">Pas certain de quel côté tu es&nbsp;? C'est à ça que sert le diagnostic.</p>
          <a data-cta="3" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Étape 9 : la preuve (le carrousel des réalisations du site, avec les logos autorisés) -->
    <section id="s-la-preuve" class="bloc bloc-alt">
      <div class="col-xl reveal">
        <p class="etiquette-lp">Réalisations</p>
        <h2>Des systèmes qui roulent déjà chez des PME d'ici</h2>
        <Realisations court={true} lang="fr" sansImageSecteur />
        <div class="centre"><a data-cta="4" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a></div>
      </div>
    </section>

    <!-- Étape 7 : qui tu rencontres -->
    <section id="s-les-references" class="bloc">
      <div class="col qui reveal">
        <figure class="qui-fig">
          <Portrait classe="qui-photo" />
          <figcaption>Simon Fournier, fondateur de FournIA.</figcaption>
        </figure>
        <div>
          <p class="etiquette-lp">Qui tu rencontres</p>
          <h2>Un seul interlocuteur, du diagnostic au dernier système</h2>
          <p>Je m'appelle Simon Fournier. J'ai lancé FournIA à Blainville en avril 2026.</p>
          <p>Je prends personnellement part à chaque dossier, du diagnostic à la formation de ton équipe. Des développeurs m'aident à bâtir les automatisations et les systèmes.</p>
        </div>
      </div>
    </section>

    <!-- Étape 6b : les 30 premiers jours -->
    <section id="s-les-30-premiers-jours" class="bloc bloc-alt">
      <div class="col-large reveal">
        <p class="etiquette-lp">Comment ça se passe</p>
        <h2>Tes 30 premiers jours</h2>
        <ol class="semaines">
          <li><span class="sem-num">Semaine 1</span><h3>On comprend ton travail.</h3><p>Une heure sur ton premier chantier : qui fait quoi, dans quel logiciel, en combien de temps.</p></li>
          <li><span class="sem-num">Semaine 2</span><h3>On prend les accès, ensemble.</h3><p>Une heure, écran partagé. Ton délai de <Fragment set:html={delai} /> part de ce jour-là.</p></li>
          <li><span class="sem-num">Semaines 3 et 4</span><h3>On bâtit, tu suis.</h3><p>Une rencontre aux deux semaines, fixée d'avance, pour voir où on en est.</p></li>
          <li><span class="sem-num">Ensuite</span><h3>Livraison et formation.</h3><p>Testé avec ton équipe, installé, et ton équipe formée. Ta garantie de 30 jours commence.</p></li>
        </ol>
      </div>
    </section>

    <!-- Étape 9b : les 16 objections -->
    <section id="s-les-16-objections" class="bloc">
      <div class="col reveal">
        <p class="etiquette-lp">Tes hésitations</p>
        <h2>Les 16 raisons de remettre ça à plus tard</h2>
        <div class="faq objections">
          {objections.map((o) => (
            <details>
              <summary>{o.q}<span class="plus" aria-hidden="true"></span></summary>
              <div class="reponse">
                {o.citation && <blockquote class="cit-obj">{o.citation.t}<cite>{o.citation.qui}</cite></blockquote>}
                {o.a.map((p) => <p>{p}</p>)}
              </div>
            </details>
          ))}
        </div>
        <div class="centre"><a data-cta="5" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a></div>
      </div>
    </section>

    <!-- Étapes 10, 12 et 13 : l'offre, c'est l'appel (le diagnostic gratuit) -->
    <section id="s-l-offre" class="bloc bloc-alt">
      <div class="col reveal">
        <p class="etiquette-lp">L'appel gratuit</p>
        <h2>Ce que tu reçois de l'appel</h2>
        <ul class="liste-coches">
          <li><span set:html={coche}></span><span><strong>Tes 3 fuites</strong>, nommées et chiffrées en heures par mois.</span></li>
          <li><span set:html={coche}></span><span><strong>La solution pour chacune</strong>, et ce que tu peux faire toi-même.</span></li>
          <li><span set:html={coche}></span><span><strong>L'ordre pour les boucher</strong> : maintenant, ensuite, plus tard.</span></li>
        </ul>
        <p>Dans les 48 heures, dans un diagnostic écrit qui est à toi. Il ne t'engage à rien.</p>
        <a data-cta="6" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
      </div>
    </section>

    <!-- Étapes 10b et 11 : l'accompagnement (si tu veux aller plus loin), bonus Loi 25, rareté -->
    <section id="s-accompagnement" class="bloc">
      <div class="col reveal">
        <p class="etiquette-lp">Si tu veux aller plus loin</p>
        <h2>L'accompagnement complet</h2>
        <div class="offre">
          <ul class="liste-coches">
            {offre.map((o) => <li><span set:html={coche}></span><span>{o}</span></li>)}
            <li><span set:html={coche}></span><span>Ton dossier Loi 25 écrit, pour chaque système qui touche des renseignements personnels.</span></li>
          </ul>
        </div>
        <p class="rarete">Nos équipes nous limitent à <em>3&nbsp;accompagnements par mois.</em></p>
      </div>
    </section>

    <!-- Étape 15 : la garantie -->
    <section id="s-la-garantie" class="bloc bloc-alt">
      <div class="col reveal">
        <p class="etiquette-lp">La garantie</p>
        <h2>Ça fonctionne et c'est optimal. Sinon, on te rembourse.</h2>
        <div class="garantie">
          <p>Si, dans les 30 jours suivant la livraison, un système ne fonctionne pas comme prévu ou ne te convient pas, tu me l'écris et tu es remboursé au complet pour ce système. C'est toi qui juges.</p>
        </div>
        <p class="petit">On retire alors ce qu'on a installé. La garantie ne s'applique pas si la livraison a été bloquée par un accès ou une information qu'on attendait de ton côté, ou par un fournisseur tiers (un refus, un délai ou un changement d'un service comme Meta, Stripe ou OpenAI).</p>
      </div>
    </section>

    <!-- Étape 16 : l'appel à l'action, étape par étape -->
    <section id="s-l-appel-a-l-action-etape-par-etape" class="bloc">
      <div class="col reveal">
        <p class="etiquette-lp">Comment réserver</p>
        <h2>Ton diagnostic, à partir d'un clic</h2>
        <ol class="etapes">
          <li><strong>Tu réponds à 3 questions</strong> et tu laisses tes coordonnées.</li>
          <li><strong>Si c'est pour toi, tu choisis ton heure.</strong></li>
          <li><strong>On se parle 30 minutes.</strong></li>
          <li><strong>Ton diagnostic écrit arrive dans les 48 heures.</strong> Il est à toi.</li>
        </ol>
        <div class="cta-bloc">
          <a data-cta="7" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Étape 13 : questions fréquentes -->
    <section id="s-questions-frequentes" class="bloc bloc-alt">
      <div class="col reveal">
        <p class="etiquette-lp">Questions fréquentes</p>
        <h2>Tes questions, avant de réserver</h2>
        <div class="faq-themes" role="navigation" aria-label="Thèmes de la FAQ">
          {faqGroupes.map((g, i) => <a href={`#faq-${i}`}>{g.titre}</a>)}
        </div>
        {faqGroupes.map((g, i) => (
          <div class="faq-groupe" id={`faq-${i}`}>
            <h3 class="faq-titre">{g.titre}</h3>
            <div class="faq">
              {g.items.map((f) => (
                <details>
                  <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
                  <div class="reponse">
                    {f.a.map((x) => <p>{x}</p>)}
                    {f.petit && <p class="petit">{f.petit}</p>}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Étape 17 : le P.S. -->
    <section id="s-le-ps" class="bloc bloc-ps">
      <div class="col reveal">
        <div class="ps">
          <p><span class="ps-tag">P.S.</span> L'essentiel, en trois points&nbsp;:</p>
          <ul class="liste-coches ps-points">
            <li><span set:html={coche}></span><span>Un appel gratuit de 30&nbsp;minutes, puis tes 3 fuites chiffrées dans un diagnostic écrit en 48&nbsp;heures.</span></li>
            <li><span set:html={coche}></span><span>Ton premier système roule <Fragment set:html={delai} /> après tes accès. Ça fonctionne, sinon on te rembourse.</span></li>
            <li><span set:html={coche}></span><span>Nos équipes nous limitent à 3&nbsp;accompagnements par mois.</span></li>
          </ul>
          <p>Si tu ne fais rien, dans un an, tu auras la même semaine, avec les mêmes demandes qui attendent ta réponse et les mêmes soirées à rattraper.</p>
          <a data-cta="8" class="btn btn-primary btn-cta btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Barre d'action fixe, mobile seulement : apparaît quand le bouton du haut sort de l'écran,
         se cache quand un autre bouton est visible. -->
    <div class="barre-cta" data-barre-cta aria-hidden="true">
      <a data-cta="9" class="btn btn-primary btn-cta" href={CTA} tabindex="-1">{ctaTexte} <span class="arrow">→</span></a>
    </div>
  </main>

  <script>
    // Barre d'action mobile : visible quand le bouton du haut est sorti de l'écran et qu'aucun autre bouton n'est visible.
    const barre = document.querySelector<HTMLElement>('[data-barre-cta]');
    const haut = document.querySelector('[data-cta-haut]');
    if (barre && haut && 'IntersectionObserver' in window) {
      const lien = barre.querySelector('a');
      const visibles = new Set<Element>();
      let hautPasse = false;
      // Cachée tant que le bandeau de consentement est ouvert : les deux se superposeraient en bas de l'écran.
      const consentement = document.getElementById('consentement');
      const maj = () => {
        const montrer = hautPasse && visibles.size === 0 && !(consentement && !consentement.hidden);
        barre.classList.toggle('visible', montrer);
        barre.setAttribute('aria-hidden', montrer ? 'false' : 'true');
        lien?.setAttribute('tabindex', montrer ? '0' : '-1');
      };
      const io = new IntersectionObserver((entrees) => {
        for (const e of entrees) {
          if (e.target === haut) hautPasse = !e.isIntersecting && e.boundingClientRect.top < 0;
          if (e.isIntersecting) visibles.add(e.target); else visibles.delete(e.target);
        }
        maj();
      });
      document.querySelectorAll('main .btn-cta:not(.barre-cta .btn-cta)').forEach((b) => io.observe(b));
      if (consentement) new MutationObserver(maj).observe(consentement, { attributes: true, attributeFilter: ['hidden'] });
    }

    // Provenance : l'angle de la pub et les UTM suivent jusqu'au formulaire de /diagnostic/ (champs cachés).
    // Jamais fbclid ni aucun identifiant publicitaire.
    try {
      const q = new URLSearchParams(location.search);
      const garder = new URLSearchParams();
      ['angle', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((k) => { const v = q.get(k); if (v) garder.set(k, v.slice(0, 120)); });
      garder.set('de', 'accompagnement-complet');
      document.querySelectorAll<HTMLAnchorElement>('a[href="/diagnostic/tu/"]').forEach((a) => { a.href = '/diagnostic/tu/?' + garder.toString(); });
    } catch (e) {}
  </script>
</Base>

<style is:global>
  @font-face { font-family: 'Anton'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/anton-latin.woff2') format('woff2'); }
</style>

<style>
