---
import Consentement from '../components/Consentement.astro';
// Landing longue de l'accompagnement complet (trafic froid Meta), formule Sabri Suby en 17 étapes.
// Copie : fournia-aios/marketing/publicites/landings-completes.md (page A).
// BROUILLON DE REVUE : les passages surlignés en jaune sont à trancher ou à vérifier par Simon.
// noindex et exclue du sitemap tant qu'elle n'est pas approuvée.
import '../styles/global.css';

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://fournia.net';
const pageUrl = 'https://fournia.net/accompagnement-complet/';
const cta = 'Réserve ton diagnostic gratuit de 30 minutes';
---
<!DOCTYPE html>
<html lang="fr-CA">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Accompagnement complet en automatisation | FournIA</title>
<meta name="description" content="On sort les tâches répétitives de ta semaine, un chantier à la fois, dans tes outils actuels. Diagnostic gratuit de 30 minutes.">
<link rel="canonical" href={pageUrl} />
<meta property="og:title" content="Accompagnement complet en automatisation | FournIA">
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_CA">
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={`${siteUrl}/brand/fournia-lockup-horizontal-dark.png`}>
<link rel="icon" type="image/svg+xml" href="/brand/fournia-favicon.svg">
<link rel="icon" type="image/png" href="/brand/fournia-icon-512.png">
<link rel="apple-touch-icon" href="/brand/fournia-icon-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Syne:wght@800&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Syne:wght@800&family=Inter:wght@400;500;600;700&display=swap"></noscript>

<style>
  /* Formule Suby : texte noir sur fond blanc, corps 18 px, paragraphes courts. Lime réservé au bouton. */
  body { background: #ffffff; color: #0b0b0c; font-size: 18px; line-height: 1.65; }
  .wrap { max-width: 680px; margin: 0 auto; padding: 1.6rem 1.1rem 3rem; }
  .brand { display: flex; align-items: center; gap: .55rem; font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.3rem; letter-spacing: -.03em; color: #0b0b0c; margin-bottom: 1.4rem; }
  .brand .mark { width: 1.7em; height: 1.7em; display: inline-flex; background: #0b0b0c; border-radius: 8px; padding: 3px; }
  .brand .mark svg { width: 100%; height: 100%; }
  .brand .ia { color: var(--lime-d); }

  .sourcil { display: block; font-size: .85rem; font-weight: 600; color: #3a3b37; background: #f3f6e8; border-left: 4px solid var(--lime-d); padding: .5rem .8rem; border-radius: 6px; margin-bottom: 1rem; }
  .stars { color: #e3a008; letter-spacing: .08em; }
  .interpelle { font-weight: 600; font-size: 1rem; margin-bottom: .6rem; color: #3a3b37; }
  h1 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(1.75rem, 6.2vw, 2.5rem); line-height: 1.12; letter-spacing: -.02em; font-weight: 700; color: #0b0b0c; margin-bottom: 1rem; }
  .sous-titre { font-size: 1.12rem; color: #2b2c29; margin-bottom: 1.4rem; }
  h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(1.4rem, 5vw, 1.8rem); line-height: 1.2; font-weight: 700; color: #0b0b0c; margin: 2.6rem 0 .9rem; }
  p { margin-bottom: 1rem; }
  ul, ol { margin: 0 0 1.2rem 1.2rem; }
  li { margin-bottom: .5rem; }
  strong { font-weight: 700; }

  .vsl { width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; background: #eceee8; border: 1px dashed #b9bcb3; display: grid; place-items: center; color: #555750; font-size: .95rem; text-align: center; padding: 1rem; margin-bottom: 1.2rem; }

  .btn { display: flex; align-items: center; justify-content: center; gap: .5rem; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.05rem; padding: 1.05rem 1.3rem; border-radius: 100px; background: var(--lime); color: #0b0b0c; text-align: center; text-decoration: none; box-shadow: 0 6px 18px rgba(159,194,58,.35); }
  .btn:hover { background: var(--lime-l); }
  .sous-bouton { text-align: center; font-size: .88rem; color: #4a4c46; margin: .55rem 0 1.4rem; }

  .verbatim { border-left: 4px solid #d6d9cf; padding: .2rem 0 .2rem 1rem; margin-bottom: 1rem; color: #2b2c29; font-style: italic; }
  .verbatim small { display: block; font-style: normal; font-size: .8rem; color: #6a6c65; margin-top: .3rem; }
  .avis { background: #f7f8f4; border: 1px solid #e3e6dc; border-radius: 12px; padding: 1rem 1.1rem; margin-bottom: .9rem; }
  .avis .qui { font-weight: 700; font-size: .95rem; margin-top: .4rem; }
  .portrait { width: 140px; height: 140px; object-fit: cover; border-radius: 50%; display: block; margin: 0 0 1rem; }
  .garantie { background: #f3f6e8; border: 2px solid var(--lime-d); border-radius: 12px; padding: 1.1rem 1.2rem; margin-bottom: .8rem; }
  .petit { font-size: .82rem; color: #555750; }
  .ps { border-top: 2px solid #0b0b0c; padding-top: 1.2rem; margin-top: 2.6rem; }

  /* Marqueurs de revue (à retirer avant la mise en ligne) */
  mark.revue { background: #fff176; color: #0b0b0c; padding: .05em .3em; border-radius: 3px; font-style: normal; font-size: .9em; font-weight: 600; }
  .bandeau-revue { background: #fff176; color: #0b0b0c; font-size: .85rem; font-weight: 600; text-align: center; padding: .55rem .8rem; }

  .foot { text-align: center; color: #6a6c65; font-size: .82rem; margin-top: 2.4rem; }
  .foot a { color: #3a3b37; }
</style>
</head>
<body>

<div class="bandeau-revue">Brouillon de revue : les passages surlignés en jaune sont à trancher ou à vérifier avant la mise en ligne.</div>

<div class="wrap">
  <a href="/" class="brand"><span class="mark" set:html={`<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g fill="none" stroke="#b7d94c" stroke-linejoin="round" stroke-linecap="round">
    <path d="M50 16 L79 33 L79 67 L50 84 L21 67 L21 33 Z" stroke-width="3"/>
    <path d="M50 50 L50 16 M50 50 L79 67 M50 50 L21 67" stroke-width="2.2" opacity="0.9"/>
  </g>
  <g fill="#b7d94c"><circle cx="50" cy="16" r="4.6"/><circle cx="79" cy="33" r="4.6"/><circle cx="79" cy="67" r="4.6"/><circle cx="50" cy="84" r="4.6"/><circle cx="21" cy="67" r="4.6"/><circle cx="21" cy="33" r="4.6"/></g>
  <circle cx="50" cy="50" r="7" fill="#c9e86b"/>
</svg>`}></span><span>Fourn<span class="ia">IA</span></span></a>

  <main>
    <!-- Étape 1 : interpeller la cible (sourcil = preuve) -->
    <span class="sourcil"><span class="stars">★★★★★</span> 5,0 sur Google · <mark class="revue">[N] avis : À VÉRIFIER</mark> · Entreprises du Québec accompagnées depuis Blainville</span>
    <p class="interpelle">Propriétaire de PME au Québec : ton téléphone, tes soumissions et tes relances reposent encore sur toi ?</p>

    <!-- Étape 2 : la grosse promesse -->
    <h1>On aide les propriétaires de PME du Québec à sortir les tâches répétitives de leur semaine <mark class="revue">[DÉLAI À TRANCHER : A « en 30 jours après les accès » ou B « plan complet en 48 heures »]</mark> grâce à un chantier d'automatisation à la fois, bâti dans leurs outils actuels, avec chaque système garanti 30 jours.</h1>

    <!-- Étape 3 : sous-titre, ouvrir une boucle -->
    <p class="sous-titre">Tu gardes les décisions. On s'occupe du reste, un système après l'autre. Et il y a une raison précise pour laquelle tout ce que tu as essayé jusqu'ici n'a pas tenu.</p>

    <div class="vsl" role="img" aria-label="Vidéo de présentation à venir">Vidéo à venir. En attendant, réserve ton diagnostic ci-dessous.</div>

    <a href="/diagnostic/" class="btn">{cta} <span aria-hidden="true">&#8594;</span></a>
    <p class="sous-bouton"><span class="stars">★★★★★</span> 5,0 sur Google · <mark class="revue">[N] avis : À VÉRIFIER</mark></p>

    <!-- Étape 4 : l'intrigue -->
    <h2>Pourquoi ça ne se règle jamais</h2>
    <p>Tu as peut-être déjà acheté un outil. Peut-être même payé quelqu'un pour te l'installer.</p>
    <p>Trois semaines plus tard, tu étais revenu à tes vieilles habitudes.</p>
    <p>Ta discipline n'a rien à voir là-dedans. Il y a une étape que presque personne ne fait avant d'installer quoi que ce soit. On te la montre plus bas.</p>

    <!-- Étape 5 : le problème -->
    <h2>Ton téléphone, tes soumissions, tes relances</h2>
    <p>Ton téléphone sonne pendant que tu es sur un chantier. Le client tombe sur ta boîte vocale.</p>
    <p>Ta soumission est partie il y a cinq jours. Personne ne l'a relancée.</p>
    <p>Le soir, tu retapes dans un logiciel ce que tu as déjà écrit dans un autre.</p>
    <p>Tu as une liste d'anciens clients. Tu te dis que tu vas les rappeler. Tu ne les rappelles pas.</p>
    <p><strong>Dans les mots de propriétaires qu'on a rencontrés :</strong></p>
    <blockquote class="verbatim">« J'oublie de faire des suivis avec les gens. J'ai des prospects, puis je me dis : je vais y penser. Puis j'oublie. »<small><mark class="revue">À VÉRIFIER : attribution du locuteur (Revoir)</mark></small></blockquote>
    <blockquote class="verbatim">« J'ai besoin d'aide demain, parce qu'aujourd'hui j'ai de la difficulté à rentrer un contrat ou une facture. »</blockquote>
    <blockquote class="verbatim">« J'ai payé quelqu'un, et il me dit tout le temps : j'ai un rendez-vous dans trois semaines. »<small><mark class="revue">À VÉRIFIER : citation retouchée, acceptable ou à retirer</mark></small></blockquote>

    <!-- Étape 6 : la solution -->
    <h2>Ce qu'on fait à la place</h2>
    <p>L'étape que presque personne ne fait : <strong>regarder comment ton travail se fait vraiment, avant de choisir un outil.</strong></p>
    <p>On mesure le temps que prend chaque étape. On trouve ce qui te coûte le plus. On commence par là.</p>
    <p>Ensuite, on bâtit le système dans les outils que tu utilises déjà. On le teste avec ton équipe. On la forme. Puis on passe au chantier suivant.</p>
    <p>Un chantier à la fois. Une rencontre aux deux semaines. Un plan clair pour la suite de ton entreprise.</p>
    <ol>
      <li><strong>On regarde tout.</strong> On rencontre l'équipe et on mesure le temps de chaque étape.</li>
      <li><strong>On te remet un plan.</strong> Quoi automatiser, dans quel ordre.</li>
      <li><strong>On automatise, un chantier à la fois.</strong> Testé avec ton équipe, installé dans tes logiciels.</li>
      <li><strong>On forme l'équipe à chaque livraison.</strong></li>
      <li><strong>On reste là.</strong> Suivi, ajustements, bilan de ce qui a été gagné.</li>
    </ol>
    <a href="/diagnostic/" class="btn">{cta} <span aria-hidden="true">&#8594;</span></a>

    <!-- Étape 7 : les références -->
    <h2>Qui est derrière FournIA</h2>
    <img class="portrait" src="/images/simon-fournier-portrait-480.webp" alt="Simon Fournier, fondateur de FournIA" width="140" height="140" loading="lazy">
    <p>Je m'appelle Simon Fournier. J'ai lancé FournIA à Blainville en avril 2026.</p>
    <p>C'est moi qui conçois chaque système, et je suis ton interlocuteur du début à la fin. Je forme aussi les équipes qui les utilisent.</p>
    <p>Depuis 2025, j'ai construit <mark class="revue">[100+ automatisations chez 10+ entreprises : À VÉRIFIER]</mark>.</p>
    <p>Chaque projet qui touche des renseignements personnels passe une vérification Loi 25, la loi québécoise sur la vie privée. Tu reçois un document de conformité écrit.</p>
    <p>Les rencontres se font en personne sur la Rive-Nord, à Laval et à Montréal, ou en visio partout au Québec.</p>

    <!-- Étape 8 : les bénéfices -->
    <h2>Ce que ça change dans ta semaine</h2>
    <p>Les appels manqués reçoivent une réponse, même quand tu es occupé.</p>
    <p>Tes soumissions sont relancées au bon moment, sans que tu y penses.</p>
    <p>Tu ne retapes plus la même information deux fois.</p>
    <p>Tes anciens clients entendent parler de toi. Tu peux approuver avant que ça parte.</p>
    <p>Ton équipe sait se servir de l'IA, et sait où elle se trompe.</p>
    <p>Tu gardes les décisions. Les systèmes préparent, relancent et trient.</p>

    <!-- Étape 9 : la preuve -->
    <h2>Ce que nos clients en disent</h2>
    <div class="avis"><span class="stars">★★★★★</span> « Ils ont automatisé la messagerie de mon entreprise […] Les suivis avec les clients se font maintenant beaucoup plus rapidement, et on sauve énormément de temps sur les tâches répétitives. »<div class="qui">Thomas Arbour · Avis Google <mark class="revue">OUI ÉCRIT À OBTENIR</mark></div></div>
    <div class="avis"><span class="stars">★★★★★</span> « Il trouve des solutions pour tous. Je le recommande à 100%. Il m'a construit une solution pour ma compagnie qui m'a sauvé énormément de temps et de maux de têtes. »<div class="qui">Freddy Aubuchon · Avis Google <mark class="revue">OUI ÉCRIT À OBTENIR</mark></div></div>
    <div class="avis"><span class="stars">★★★★★</span> « J'ai adoré mon expérience avec Simon! Il était vraiment à l'écoute de mes besoins et est arrivé avec plusieurs idées pour améliorer les pratiques de mon entreprise ! Je le recommande à tous ! »<div class="qui">Karyann Turcotte · Avis Google <mark class="revue">OUI ÉCRIT À OBTENIR</mark></div></div>
    <div class="avis"><span class="stars">★★★★★</span> « Malade, j'ai adoré mon expérience. »<div class="qui">Stéphane Bernier · Avis Google <mark class="revue">OUI ÉCRIT À OBTENIR</mark></div></div>
    <p class="petit"><mark class="revue">À TRANCHER : l'avis d'Alexandre Mercier (partenaire) est retiré par défaut.</mark></p>
    <p><strong>Des systèmes qui roulent chez nos clients :</strong></p>
    <ul>
      <li><strong>AvecPlaisirs (traiteur corporatif) :</strong> les 6 documents de production d'une journée sortent d'un clic. Plus rien à retaper.</li>
      <li><strong>Pubsphere :</strong> fini la saisie à la main. Chaque transaction est lue, il ne reste qu'à réviser.</li>
      <li><strong>Karyann Turcotte :</strong> ses <mark class="revue">[100 : À VÉRIFIER]</mark> clients suivis automatiquement par texto, sans écrire un seul message.</li>
      <li><strong>Arbour Aide Académique :</strong> chaque parent reçoit une réponse en quelques minutes, avec de vraies plages libres.</li>
    </ul>
    <a href="/diagnostic/" class="btn">{cta} <span aria-hidden="true">&#8594;</span></a>

    <!-- Étape 10 : l'offre -->
    <h2>Ce que tu obtiens</h2>
    <p><strong>L'accompagnement complet FournIA :</strong></p>
    <ul>
      <li>Le diagnostic de ton entreprise et un plan priorisé.</li>
      <li>Les systèmes bâtis, testés et installés dans tes outils actuels, un chantier à la fois.</li>
      <li>La formation de ton équipe à chaque livraison.</li>
      <li>Une rencontre aux deux semaines, en personne ou en visio.</li>
      <li>Les ajustements quand tes besoins changent, et un bilan de ce qui a été gagné.</li>
      <li>Tous les outils et les comptes restent à ton nom.</li>
    </ul>
    <p>Et si, au diagnostic, on voit qu'un seul système suffit, on te le dit. On te bâtit ce système-là, sans t'en vendre plus.</p>

    <!-- Étape 11 : les bonus -->
    <h2>Les bonus</h2>
    <p><mark class="revue">BONUS À TRANCHER : option A ou B</mark></p>
    <p><strong>Option A</strong></p>
    <ol>
      <li><strong>Le rapport des 3 fuites, en 48 heures.</strong> Un PDF de 2 pages : tes 3 plus grosses pertes de temps, chiffrées en heures, et l'ordre pour les régler. Tu le gardes, même si tu ne fais rien avec nous.</li>
      <li><strong>La politique d'usage de l'IA d'une page</strong>, rédigée pour ton équipe, prête à adopter.</li>
      <li><strong>Le document de conformité Loi 25</strong> de chaque système, écrit, pour ton dossier.</li>
    </ol>
    <p><strong>Option B</strong></p>
    <ol>
      <li>Le rapport des 3 fuites en 48 heures.</li>
      <li><strong>L'aide-mémoire de demandes prêtes à l'emploi</strong>, écrit pour les tâches de ton équipe.</li>
      <li><strong>La formation d'une personne de ton équipe</strong> qui devient la référence IA à l'interne.</li>
    </ol>

    <!-- Étape 12 : ce que tu repars avec (aucune valeur chiffrée) -->
    <h2>Ce que tu repars avec</h2>
    <p>Après 30 minutes, tu repars avec :</p>
    <ul>
      <li><strong>Tes 3 plus grosses pertes de temps</strong>, nommées et chiffrées en heures par semaine.</li>
      <li><strong>Pour chacune, la solution en mots simples</strong>, et ce que tu peux faire toi-même, sans nous.</li>
      <li><strong>L'ordre pour les régler</strong> : maintenant, ensuite, plus tard.</li>
    </ul>
    <p>Le tout dans un diagnostic écrit de 2 pages, envoyé dans les 48 heures. Il est à toi.</p>
    <a href="/diagnostic/" class="btn">{cta} <span aria-hidden="true">&#8594;</span></a>

    <!-- Étape 13 : gratuit, sans engagement -->
    <h2>Gratuit, sans engagement</h2>
    <p><strong>Le diagnostic est gratuit, sans engagement.</strong></p>
    <p>Si tu veux aller plus loin après, on te présente l'accompagnement en personne, avec le plan devant toi. Si tu ne veux pas, tu gardes ton diagnostic écrit.</p>

    <!-- Étape 14 : rareté réelle -->
    <h2>Pourquoi les places sont limitées</h2>
    <p><strong>Nos équipes nous limitent à 3 accompagnements par mois.</strong></p>
    <p>Quand c'est complet, on t'inscrit pour le mois suivant, et on peut quand même te bâtir un système précis en attendant.</p>

    <!-- Étape 15 : la garantie -->
    <h2>Notre garantie</h2>
    <div class="garantie"><strong>Chaque système livré est garanti 30 jours.</strong> Si un bogue l'empêche de faire ce qui était prévu au contrat, on le corrige sans frais. Si on n'arrive pas à le corriger dans les 10 jours ouvrables après ton signalement écrit, tu es remboursé au complet pour ce système.</div>
    <p class="petit">La garantie ne s'applique pas quand le problème vient d'une obligation du client non remplie (accès, informations), d'un changement ou d'un refus d'un service tiers (par exemple Meta, Instagram, Stripe, OpenAI), ou d'un retrait de contenu pour une question de droits d'auteur.</p>

    <!-- Étape 16 : l'appel à l'action, étape par étape -->
    <h2>Comment ça marche, étape par étape</h2>
    <ol>
      <li><strong>Tu cliques sur le bouton</strong> ci-dessous.</li>
      <li><strong>Tu réponds à 3 questions.</strong></li>
      <li><strong>Si c'est pour toi, tu choisis ton heure</strong> dans le calendrier.</li>
      <li><strong>On se parle 30 minutes.</strong> On regarde où ton temps part et par quoi commencer.</li>
      <li><strong>Tu reçois ton diagnostic écrit dans les 48 heures.</strong> Il est à toi, que tu travailles avec nous ou non.</li>
    </ol>
    <a href="/diagnostic/" class="btn">{cta} <span aria-hidden="true">&#8594;</span></a>
    <p class="sous-bouton"><span class="stars">★★★★★</span> 5,0 sur Google · <mark class="revue">[N] avis : À VÉRIFIER</mark></p>

    <!-- Étape 17 : le P.S. -->
    <div class="ps">
      <p><strong>P.S.</strong> Si tu ne retiens qu'une chose : tant que rien ne change, les mêmes tâches te prennent les mêmes heures, chaque semaine. Le diagnostic prend 30 minutes, il est gratuit, sans engagement, et ton diagnostic écrit est à toi même si tu ne fais rien avec nous.</p>
      <a href="/diagnostic/" class="btn">Réserve ton diagnostic <span aria-hidden="true">&#8594;</span></a>
    </div>
  </main>

  <div class="foot">
    <a href="/">Accueil</a> &nbsp;·&nbsp; <a href="/confidentialite">Politique de confidentialité</a> &nbsp;·&nbsp; &#169; 2026 FournIA
  </div>
</div>

<Consentement />
</body>
</html>
