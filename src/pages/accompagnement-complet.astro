---
// Landing longue de l'accompagnement complet (trafic froid Meta), formule Sabri Suby en 17 étapes.
// Copie : fournia-aios/marketing/publicites/landings-completes.md (page A), reprise telle quelle.
// BROUILLON DE REVUE : les pastilles pointillées ambre sont à trancher ou à vérifier par Simon avant
// la mise en ligne. noindex et exclue du sitemap (astro.config.mjs) tant qu'elle n'est pas approuvée.
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';

const CTA = '/diagnostic/';
const ctaTexte = 'Réserve ton diagnostic gratuit de 30 minutes';

const avis = [
  { auteur: 'Thomas Arbour', texte: "Ils ont automatisé la messagerie de mon entreprise […] Les suivis avec les clients se font maintenant beaucoup plus rapidement, et on sauve énormément de temps sur les tâches répétitives." },
  { auteur: 'Freddy Aubuchon', texte: "Il trouve des solutions pour tous. Je le recommande à 100%. Il m'a construit une solution pour ma compagnie qui m'a sauvé énormément de temps et de maux de têtes." },
  { auteur: 'Karyann Turcotte', texte: "J'ai adoré mon expérience avec Simon! Il était vraiment à l'écoute de mes besoins et est arrivé avec plusieurs idées pour améliorer les pratiques de mon entreprise ! Je le recommande à tous !" },
  { auteur: 'Stéphane Bernier', texte: "Malade, j'ai adoré mon expérience." },
];

const realisations = [
  { client: 'AvecPlaisirs', secteur: 'traiteur corporatif', texte: "Les 6 documents de production d'une journée sortent d'un clic. Plus rien à retaper." },
  { client: 'Pubsphere', texte: "Fini la saisie à la main : chaque transaction est lue, il ne reste qu'à réviser." },
  { client: 'Karyann Turcotte', texte: 'Ses 100 clients suivis automatiquement par texto, sans écrire un seul message.', verifier: '« 100 » · à vérifier' },
  { client: 'Arbour Aide Académique', texte: 'Chaque parent reçoit une réponse en quelques minutes, avec de vraies plages libres.' },
];

const benefices = [
  'Les appels manqués reçoivent une réponse, même quand tu es occupé.',
  'Tes soumissions sont relancées au bon moment, sans que tu y penses.',
  'Tu ne retapes plus la même information deux fois.',
  'Tes anciens clients entendent parler de toi. Tu peux approuver avant que ça parte.',
  "Ton équipe sait se servir de l'IA, et sait où elle se trompe.",
  'Tu gardes les décisions. Les systèmes préparent, relancent et trient.',
];

const offre = [
  'Le diagnostic de ton entreprise et un plan priorisé.',
  'Les systèmes bâtis, testés et installés dans tes outils actuels, un chantier à la fois.',
  'La formation de ton équipe à chaque livraison.',
  'Une rencontre aux deux semaines, en personne ou en visio.',
  'Les ajustements quand tes besoins changent, et un bilan de ce qui a été gagné.',
  'Tous les outils et les comptes restent à ton nom.',
];

const bonus = [
  { t: 'Ton dossier Loi 25, écrit', d: "Pour chaque système qu'on bâtit, un document dit quelles données il touche, où elles vont et qui y a accès. Si un client te pose la question, la réponse est déjà écrite." },
  { t: "La politique d'usage de l'IA de ton équipe", d: "Une page claire : ce que ton équipe peut faire avec l'IA, ce qu'elle ne fait jamais, comme y coller les données d'un client, et à qui demander en cas de doute. Prête à afficher." },
  { t: "L'aide-mémoire de demandes prêtes à l'emploi", d: 'Les demandes à copier-coller pour les tâches de ton équipe : courriels, soumissions, résumés. Écrites pour ton métier, utilisables dès le premier jour.' },
];

// FAQ : réponses reprises de la page /accompagnement-intelligence-artificielle/ (mises au « tu »).
const faq = [
  { q: "Mon équipe ne connaît rien à l'IA. Est-ce un problème ?", a: "Non. C'est justement pour ça que l'accompagnement existe. On explique en mots simples comment l'IA fonctionne, ce qu'elle fait bien et ce qu'elle fait mal, avant de toucher à tes outils. Personne n'a besoin de connaissances techniques au départ." },
  { q: 'Combien de temps dure un accompagnement complet ?', a: "Généralement de 6 mois à 1 an, selon la taille de l'entreprise et le nombre de processus à revoir. Le plan du début fixe l'ordre des chantiers et le rythme des rencontres." },
  { q: "L'accompagnement se fait-il en personne ?", a: 'En personne ou à distance. Les rencontres se font en personne sur la Rive-Nord de Montréal, à Laval et à Montréal, ou par visioconférence partout au Québec.' },
  { q: 'Comment FournIA respecte-t-elle la Loi 25 ?', a: "Chaque projet qui touche des renseignements personnels passe par une vérification Loi 25 avant la construction, avec une attention particulière au transfert de données hors Québec quand un modèle d'IA est utilisé. Tu reçois un document de conformité écrit." },
];

const etoile = '<path d="M10 1.6l2.47 5.3 5.8.68-4.3 3.96 1.15 5.73L10 14.4l-5.12 2.87 1.15-5.73-4.3-3.96 5.8-.68z"/>';
const etoiles = '<svg class="etoiles" viewBox="0 0 100 20" aria-hidden="true">' + [0, 1, 2, 3, 4].map((i) => '<g transform="translate(' + i * 20 + ' 0)">' + etoile + '</g>').join('') + '</svg>';
const coche = '<svg class="coche" viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base title="Accompagnement complet en automatisation | FournIA" description="On sort les tâches répétitives de ta semaine, un chantier à la fois, dans tes outils actuels. Diagnostic gratuit de 30 minutes." canonical="https://fournia.net/accompagnement-complet/" minimal>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <main class="lp">
    <!-- Au-dessus du pli : étapes 1 à 3, vidéo, bouton, preuve. Sans animation (LCP). -->
    <header class="hero">
      <div class="col col-hero">
        <p class="brouillon">Brouillon de revue · les pastilles pointillées sont à trancher ou à vérifier</p>

        <!-- Étape 1 : la preuve d'abord, puis la personne visée -->
        <p class="preuve-haut">
          <span class="g" aria-hidden="true">G</span>
          <span class="etoiles-w" set:html={etoiles}></span>
          <span><strong>5,0</strong> sur Google <span class="pastille">[N] avis · à vérifier</span> · entreprises du Québec accompagnées depuis Blainville</span>
        </p>
        <p class="interpelle">Propriétaire de PME au Québec : ton téléphone, tes soumissions et tes relances reposent encore sur toi ?</p>

        <!-- Étape 2 : la grosse promesse -->
        <h1>Récupère <em>tes soirées</em> : ton premier système roule 30&nbsp;jours après tes accès.</h1>

        <!-- Étape 3 : sous-titre (le reste de la promesse), ouvrir une boucle -->
        <p class="sous-titre">On bâtit un chantier d'automatisation à la fois, dans tes outils actuels, et chaque système est garanti 30&nbsp;jours. Tu gardes les décisions, et il y a une raison précise pour laquelle tout ce que tu as essayé jusqu'ici n'a pas tenu.</p>

        <figure class="vsl" aria-label="Vidéo de présentation, à venir">
          <div class="vsl-ecran">
            <img class="vsl-mono" src="/brand/fournia-monogram.svg" alt="" width="120" height="120" />
            <span class="play" aria-hidden="true"></span>
          </div>
          <figcaption>Vidéo à venir. En attendant, réserve ton diagnostic ci-dessous.</figcaption>
        </figure>

        <div class="cta-bloc">
          <a class="btn btn-primary btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
          <p class="sous-cta"><span class="etoiles-w" set:html={etoiles}></span> 5,0 sur Google <span class="pastille">[N] avis · à vérifier</span></p>
        </div>
      </div>
    </header>

    <!-- Étape 4 : l'intrigue -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Pourquoi ça ne se règle jamais</h2>
        <p class="grand">Tu as peut-être déjà acheté un outil. Peut-être même payé quelqu'un pour te l'installer.</p>
        <p class="grand">Trois semaines plus tard, tu étais revenu à tes vieilles habitudes.</p>
        <p>Ta discipline n'a rien à voir là-dedans. Il y a une étape que presque personne ne fait avant d'installer quoi que ce soit. On te la montre plus bas.</p>
      </div>
    </section>

    <!-- Étape 5 : le problème -->
    <section class="bloc bloc-alt">
      <div class="col reveal">
        <h2>Ton téléphone, tes soumissions, tes relances</h2>
        <ul class="scenes">
          <li>Ton téléphone sonne pendant que tu es sur un chantier. Le client tombe sur ta boîte vocale.</li>
          <li>Ta soumission est partie il y a cinq jours. Personne ne l'a relancée.</li>
          <li>Le soir, tu retapes dans un logiciel ce que tu as déjà écrit dans un autre.</li>
          <li>Tu as une liste d'anciens clients. Tu te dis que tu vas les rappeler. Tu ne les rappelles pas.</li>
        </ul>
        <h3 class="h3-mots">Dans les mots de propriétaires qu'on a rencontrés</h3>
        <div class="citations">
          <blockquote><p>J'oublie de faire des suivis avec les gens. J'ai des prospects, puis je me dis : je vais y penser. Puis j'oublie.</p><span class="pastille">attribution Revoir · à vérifier</span></blockquote>
          <blockquote><p>J'ai besoin d'aide demain, parce qu'aujourd'hui j'ai de la difficulté à rentrer un contrat ou une facture.</p></blockquote>
          <blockquote><p>J'ai payé quelqu'un, et il me dit tout le temps : j'ai un rendez-vous dans trois semaines.</p><span class="pastille">citation retouchée · à vérifier</span></blockquote>
        </div>
      </div>
    </section>

    <!-- Étape 6 : la solution -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Ce qu'on fait à la place</h2>
        <p class="grand">L'étape que presque personne ne fait : <strong>regarder comment ton travail se fait vraiment, avant de choisir un outil.</strong></p>
        <p>On mesure le temps que prend chaque étape. On trouve ce qui te coûte le plus. On commence par là.</p>
        <p>Ensuite, on bâtit le système dans les outils que tu utilises déjà. On le teste avec ton équipe. On la forme. Puis on passe au chantier suivant.</p>
        <p>Un chantier à la fois. Une rencontre aux deux semaines. Un plan clair pour la suite de ton entreprise.</p>
        <ol class="etapes">
          <li><strong>On regarde tout.</strong> On rencontre l'équipe et on mesure le temps de chaque étape.</li>
          <li><strong>On te remet un plan.</strong> Quoi automatiser, dans quel ordre.</li>
          <li><strong>On automatise, un chantier à la fois.</strong> Testé avec ton équipe, installé dans tes logiciels.</li>
          <li><strong>On forme l'équipe à chaque livraison.</strong></li>
          <li><strong>On reste là.</strong> Suivi, ajustements, bilan de ce qui a été gagné.</li>
        </ol>
        <a class="btn btn-primary btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
      </div>
    </section>

    <!-- Étape 7 : les références -->
    <section class="bloc bloc-alt">
      <div class="col qui reveal">
        <Portrait classe="qui-photo" />
        <div>
          <h2>Qui est derrière FournIA</h2>
          <p>Je m'appelle Simon Fournier. J'ai lancé FournIA à Blainville en avril 2026.</p>
          <p>C'est moi qui conçois chaque système, et je suis ton interlocuteur du début à la fin. Je forme aussi les équipes qui les utilisent.</p>
          <p>Depuis 2025, j'ai construit 100+ automatisations chez 10+ entreprises. <span class="pastille">chiffre à vérifier</span></p>
          <p>Chaque projet qui touche des renseignements personnels passe une vérification Loi 25, la loi québécoise sur la vie privée. Tu reçois un document de conformité écrit.</p>
          <p>Les rencontres se font en personne sur la Rive-Nord, à Laval et à Montréal, ou en visio partout au Québec.</p>
        </div>
      </div>
    </section>

    <!-- Étape 8 : les bénéfices -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Ce que ça change dans ta semaine</h2>
        <ul class="liste-coches">
          {benefices.map((b) => <li><span set:html={coche}></span><span>{b}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- Étape 9 : la preuve -->
    <section class="bloc bloc-alt">
      <div class="col-large reveal">
        <h2>Ce que nos clients en disent</h2>
        <div class="avis-grille">
          {avis.map((a) => (
            <figure class="carte-avis">
              <span class="etoiles-w" set:html={etoiles}></span>
              <blockquote>« {a.texte} »</blockquote>
              <figcaption><strong>{a.auteur}</strong><span>Avis Google</span><span class="pastille">oui écrit à obtenir</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="note-revue note-bas"><span class="pastille">à trancher</span> l'avis d'Alexandre Mercier (partenaire) est retiré par défaut.</p>

        <h3 class="h3-real">Des systèmes qui roulent chez nos clients</h3>
        <ul class="realisations">
          {realisations.map((r) => (
            <li>
              <strong>{r.client}{r.secteur && <span class="secteur">{r.secteur}</span>}</strong>
              <span>{r.texte}{r.verifier && <span class="pastille">{r.verifier}</span>}</span>
            </li>
          ))}
        </ul>
        <div class="centre"><a class="btn btn-primary btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a></div>
      </div>
    </section>

    <!-- Étape 10 : l'offre -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Ce que tu obtiens</h2>
        <div class="offre">
          <p class="offre-titre">L'accompagnement complet <span class="wm">Fourn<span>IA</span></span></p>
          <ul class="liste-coches">
            {offre.map((o) => <li><span set:html={coche}></span><span>{o}</span></li>)}
          </ul>
        </div>
        <p class="grand">Et si, au diagnostic, on voit qu'un seul système suffit, on te le dit. On te bâtit ce système-là, sans t'en vendre plus.</p>
      </div>
    </section>

    <!-- Étape 11 : les bonus -->
    <section class="bloc bloc-alt">
      <div class="col-large reveal">
        <h2>En plus, quand tu commences l'accompagnement</h2>
        <p class="bonus-intro">Ces trois documents sont inclus dès ton premier mois. Ils sont à toi.</p>
        <div class="bonus-grille">
          {bonus.map((x, i) => (
            <article class="bonus">
              <span class="bonus-num" aria-hidden="true">{i + 1}</span>
              <h3>{x.t}</h3>
              <p>{x.d}</p>
            </article>
          ))}
        </div>
        <p class="note-revue note-bas"><span class="pastille">cartes 2 et 3 : gabarits à bâtir avant la mise en ligne</span></p>
      </div>
    </section>

    <!-- Étapes 12 et 13 : ce que tu repars avec, gratuit -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Ce que tu repars avec</h2>
        <p>Après 30 minutes, tu repars avec :</p>
        <ul class="liste-coches">
          <li><span set:html={coche}></span><span><strong>Tes 3 plus grosses pertes de temps</strong>, nommées et chiffrées en heures par semaine.</span></li>
          <li><span set:html={coche}></span><span><strong>Pour chacune, la solution en mots simples</strong>, et ce que tu peux faire toi-même, sans nous.</span></li>
          <li><span set:html={coche}></span><span><strong>L'ordre pour les régler</strong> : maintenant, ensuite, plus tard.</span></li>
        </ul>
        <p>Le tout dans un diagnostic écrit de 2 pages, envoyé dans les 48 heures. Il est à toi.</p>

        <h2 class="h2-suite">Gratuit, sans engagement</h2>
        <p class="grand"><strong>Le diagnostic est gratuit, sans engagement.</strong></p>
        <p>Si tu veux aller plus loin après, on te présente l'accompagnement en personne, avec le plan devant toi. Si tu ne veux pas, tu gardes ton diagnostic écrit.</p>
        <a class="btn btn-primary btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
      </div>
    </section>

    <!-- Étape 14 : rareté réelle -->
    <section class="bloc bloc-alt">
      <div class="col reveal">
        <h2>Pourquoi les places sont limitées</h2>
        <p class="rarete">Nos équipes nous limitent à <em>3&nbsp;accompagnements par mois.</em></p>
        <p>Quand c'est complet, on t'inscrit pour le mois suivant, et on peut quand même te bâtir un système précis en attendant.</p>
      </div>
    </section>

    <!-- Étape 15 : la garantie -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Notre garantie</h2>
        <div class="garantie">
          <svg class="bouclier" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 4l16 6v12c0 10-6.8 18.4-16 22-9.2-3.6-16-12-16-22V10z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/><path d="M16.5 24.5l5 5 10-11" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div>
            <p class="garantie-titre">Chaque système livré est garanti 30 jours.</p>
            <p>Si un bogue l'empêche de faire ce qui était prévu au contrat, on le corrige sans frais. Si on n'arrive pas à le corriger dans les 10 jours ouvrables après ton signalement écrit, tu es remboursé au complet pour ce système.</p>
          </div>
        </div>
        <p class="petit">La garantie ne s'applique pas quand le problème vient d'une obligation du client non remplie (accès, informations), d'un changement ou d'un refus d'un service tiers (par exemple Meta, Instagram, Stripe, OpenAI), ou d'un retrait de contenu pour une question de droits d'auteur.</p>
      </div>
    </section>

    <!-- Étape 16 : l'appel à l'action, étape par étape -->
    <section class="bloc bloc-alt">
      <div class="col reveal">
        <h2>Comment ça marche, étape par étape</h2>
        <ol class="etapes">
          <li><strong>Tu cliques sur le bouton</strong> ci-dessous.</li>
          <li><strong>Tu réponds à 3 questions.</strong></li>
          <li><strong>Si c'est pour toi, tu choisis ton heure</strong> dans le calendrier.</li>
          <li><strong>On se parle 30 minutes.</strong> On regarde où ton temps part et par quoi commencer.</li>
          <li><strong>Tu reçois ton diagnostic écrit dans les 48 heures.</strong> Il est à toi, que tu travailles avec nous ou non.</li>
        </ol>
        <div class="cta-bloc">
          <a class="btn btn-primary btn-xl" href={CTA}>{ctaTexte} <span class="arrow">→</span></a>
          <p class="sous-cta"><span class="etoiles-w" set:html={etoiles}></span> 5,0 sur Google <span class="pastille">[N] avis · à vérifier</span></p>
        </div>
      </div>
    </section>

    <!-- Questions fréquentes (reprises de la page Accompagnement) -->
    <section class="bloc">
      <div class="col reveal">
        <h2>Questions fréquentes</h2>
        <p class="note-revue"><span class="pastille">à valider</span> réponses reprises de la page Accompagnement, mises au « tu ».</p>
        <div class="faq">
          {faq.map((f) => (
            <details>
              <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Étape 17 : le P.S. -->
    <section class="bloc bloc-ps">
      <div class="col reveal">
        <div class="ps">
          <p><span class="ps-tag">P.S.</span> Si tu ne retiens qu'une chose : tant que rien ne change, les mêmes tâches te prennent les mêmes heures, chaque semaine. Le diagnostic prend 30 minutes, il est gratuit, sans engagement, et ton diagnostic écrit est à toi même si tu ne fais rien avec nous.</p>
          <a class="btn btn-primary btn-xl" href={CTA}>Réserve ton diagnostic <span class="arrow">→</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .lp { position: relative; z-index: 1; --texte: #eceee7; --texte-2: #c9cbc3; --fond-alt: #131411; }
  .col { width: min(680px, 88vw); margin: 0 auto; }
  .col-large { width: min(940px, 88vw); margin: 0 auto; }
  .col-hero { width: min(820px, 88vw); }

  /* Lecture Suby, adaptée au fond foncé : 18 px et plus, interligne généreux, texte clair à fort contraste. */
  .lp p, .lp li { font-size: 1.125rem; line-height: 1.72; color: var(--texte-2); }
  .lp p { margin-bottom: 1.1rem; }
  .lp strong { color: var(--texte); font-weight: 600; }
  .lp .grand { font-size: 1.3rem; line-height: 1.55; color: var(--texte); }
  .lp h2 { font-size: clamp(1.8rem, 4.4vw, 2.5rem); line-height: 1.1; letter-spacing: -.03em; font-weight: 700; color: var(--white); margin-bottom: 1.5rem; }
  .lp h3 { font-size: 1.2rem; font-weight: 600; color: var(--white); letter-spacing: -.01em; }

  /* Pastilles de revue : discrètes, à retirer avant la mise en ligne */
  .pastille { display: inline-flex; align-items: center; vertical-align: middle; font-family: 'Inter', 'Inter Repli', sans-serif; font-size: .72rem; font-weight: 500; line-height: 1.3; letter-spacing: .01em;
    color: #e7b65a; border: 1px dashed rgba(231,182,90,.7); border-radius: 6px; padding: .12rem .45rem; margin: 0 .25rem; }
  .lp .note-revue { font-size: .85rem; line-height: 1.5; color: #c4b48c; margin: -.5rem 0 1.6rem; }
  .lp .note-revue .pastille { margin-left: 0; }
  .lp .brouillon { display: inline-block; font-size: .78rem; line-height: 1.4; color: #c4b48c; border: 1px dashed rgba(231,182,90,.45); border-radius: 100px; padding: .3rem .85rem; margin-bottom: 1.8rem; }

  /* ── Haut de page ── */
  .hero { padding: 8.4rem 0 4.6rem; }
  .lp .preuve-haut { display: block; font-size: .9rem; line-height: 1.5; color: var(--texte-2); margin-bottom: 1.4rem; }
  .preuve-haut strong { color: var(--white); }
  .preuve-haut > * { vertical-align: middle; }
  .preuve-haut .etoiles-w { margin: 0 .45rem 0 .35rem; }
  .g { width: 1.45rem; height: 1.45rem; border-radius: 50%; display: inline-grid; place-items: center; background: #fff; color: #4285f4; font-family: 'Space Grotesk', 'Space Grotesk Repli', sans-serif; font-weight: 700; font-size: .82rem; }
  .etoiles-w { display: inline-flex; }
  .lp :global(.etoiles) { width: 5.1rem; height: 1rem; fill: var(--lime); display: block; }
  .lp .interpelle { font-size: 1.15rem; line-height: 1.5; font-weight: 500; color: var(--texte); margin-bottom: 1.1rem; }
  .hero h1 { font-size: clamp(2.1rem, 5.2vw, 3.3rem); line-height: 1.07; letter-spacing: -.035em; font-weight: 700; color: var(--white); margin-bottom: 1.2rem; text-wrap: balance; }
  .hero h1 em { font-style: normal; color: var(--lime); }
  .lp .sous-titre { font-size: 1.22rem; line-height: 1.6; color: var(--texte); margin-bottom: 2.2rem; }

  .vsl { margin: 0 0 2.2rem; }
