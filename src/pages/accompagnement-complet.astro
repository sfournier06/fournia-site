  <script>
    // Barre d'action mobile : visible quand le bouton du haut est sorti de l'écran et qu'aucun autre bouton n'est visible.
    const barre = document.querySelector<HTMLElement>('[data-barre-cta]');
    const haut = document.querySelector('[data-cta-haut]');
    if (barre && haut && 'IntersectionObserver' in window) {
      const lien = barre.querySelector('a');
      const visibles = new Set<Element>();
      let hautPasse = false;
      // Cachée tant que le bandeau de consentement est ouvert : les deux se superposeraient en bas de l'écran.
      const consentement = document.getElementById('consentement');
      const maj = () => {
        const montrer = hautPasse && visibles.size === 0 && !(consentement && !consentement.hidden);
        barre.classList.toggle('visible', montrer);
        barre.setAttribute('aria-hidden', montrer ? 'false' : 'true');
        lien?.setAttribute('tabindex', montrer ? '0' : '-1');
      };
      const io = new IntersectionObserver((entrees) => {
        for (const e of entrees) {
          if (e.target === haut) hautPasse = !e.isIntersecting && e.boundingClientRect.top < 0;
          if (e.isIntersecting) visibles.add(e.target); else visibles.delete(e.target);
        }
        maj();
      });
      document.querySelectorAll('main .btn-cta:not(.barre-cta .btn-cta)').forEach((b) => io.observe(b));
      if (consentement) new MutationObserver(maj).observe(consentement, { attributes: true, attributeFilter: ['hidden'] });
    }

    // Provenance : l'angle de la pub et les UTM suivent jusqu'au formulaire de /diagnostic/ (champs cachés).
    // Jamais fbclid ni aucun identifiant publicitaire.
    try {
      const q = new URLSearchParams(location.search);
      const garder = new URLSearchParams();
      ['angle', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((k) => { const v = q.get(k); if (v) garder.set(k, v.slice(0, 120)); });
      garder.set('de', 'accompagnement-complet');
      document.querySelectorAll<HTMLAnchorElement>('a[href="/diagnostic/tu/"]').forEach((a) => { a.href = '/diagnostic/tu/?' + garder.toString(); });
    } catch (e) {}
  </script>
