---
import ServicePage from '../../layouts/ServicePage.astro';
import { ZONES, SECTEURS } from '../../data/entite.mjs';

const faq = [
  {
    q: "Mon secteur n'est pas dans la liste, est-ce que FournIA peut m'aider ?",
    a: "Probablement. Les mêmes besoins reviennent dans la plupart des PME de service : répondre vite aux demandes, relancer les soumissions, suivre les clients et éliminer la double saisie. L'appel découverte sert justement à le vérifier.",
  },
];
---
<ServicePage
  path="/secteurs"
  title="Automatisation IA par secteur d'activité | FournIA"
  description="Comment l'automatisation et l'IA aident les PME de service du Québec, secteur par secteur : thermopompes, rénovation, événementiel, traiteurs, conseillers financiers, courtiers immobiliers, cliniques, cabinets comptables, tutorat, agences marketing et formation des employés."
  h1="L'automatisation IA, secteur par secteur"
  lead="Chaque secteur perd du temps à des endroits différents. Voici, pour chacun, les tâches qui coûtent le plus et ce que FournIA peut automatiser."
  serviceName="Secteurs"
  serviceType="Automatisation des processus pour PME"
  areaServed={ZONES}
  faq={faq}
  updated="2026-11-04"
>
  <h2>Les secteurs</h2>
  <ul>
    {SECTEURS.map((s) => <li><strong><a href={s.href}>{s.label}</a></strong> : {s.resume}</li>)}
  </ul>
</ServicePage>
