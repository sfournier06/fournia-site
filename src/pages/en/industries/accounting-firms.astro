---
// Version anglaise de /secteurs/cabinets-comptables/. Traduction fidèle, aucune promesse ajoutée.
import ServicePage from '../../../layouts/ServicePage.astro';
import { ZONES } from '../../../data/entite.mjs';

const zones = ZONES.map((z) => (z === 'Montréal' ? 'Montreal' : z));

const faq = [
  {
    q: 'Which tasks can an accounting firm automate?',
    a: 'Collecting documents and following up on them, appointment booking, answering frequently asked questions and part of the data entry.',
  },
  {
    q: "Is clients' financial data protected?",
    a: "Every project goes through a review under Quebec's privacy law (Law 25). We limit what goes through an AI tool and document where the data is hosted.",
  },
  {
    q: "Does AI replace the accountant's review?",
    a: 'No. It prepares and sorts; your team checks and signs off.',
  },
];
---
<ServicePage
  lang="en"
  alt="/secteurs/cabinets-comptables/"
  image="/images/secteurs/cabinets-comptables.webp"
  imageAlt="An accounting firm's office"
  path="/en/industries/accounting-firms"
  title="Automation for accounting firms | FournIA"
  description="Automatic follow-ups for document collection, scheduled appointments, frequent questions answered: AI automation for accounting firms in Quebec."
  h1="Automation for accounting firms"
  lead="During tax season, time goes into collecting documents and following up with clients. FournIA automates those follow-ups, appointments and answers to recurring questions, so your team can focus on the files."
  serviceName="Accounting firms"
  serviceType="Process automation for small businesses"
  areaServed={zones}
  faq={faq}
  updated="2026-11-18"
>
  <h2>What costs time</h2>
  <ul>
    <li>Clients who send their documents late, or incomplete.</li>
    <li>Follow-ups done one by one, by hand.</li>
    <li>The same questions about deadlines and the documents to provide.</li>
    <li>Data copied from a document into software.</li>
  </ul>

  <h2>What FournIA can automate</h2>
  <ul>
    <li>A personalized document list sent to each client.</li>
    <li>Automatic follow-ups until the file is complete.</li>
    <li>Online appointment booking.</li>
    <li>Answers to frequently asked questions.</li>
    <li>Data extraction from documents, checked by your team.</li>
  </ul>
  <p>You stay in control of decisions. The system prepares, you approve.</p>

  <h2>How it works</h2>
  <ol>
    <li><strong>A free 30-minute discovery call.</strong></li>
    <li><strong>An assessment</strong> of your process, from the request to delivery.</li>
    <li><strong>The build</strong> on your tools, one automation at a time.</li>
    <li><strong>Training</strong> for your team and follow-up.</li>
  </ol>
  <p>Every project that involves personal information goes through a review under Quebec's privacy law (<a href="/en/blog/law-25-ai-compliance-quebec-2026/">Law 25</a>). See also the <a href="/en/industries/">other industries</a>.</p>
</ServicePage>
