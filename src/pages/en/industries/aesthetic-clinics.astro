---
// Version anglaise de /secteurs/cliniques-esthetique/. Traduction fidèle, aucune promesse ajoutée.
import ServicePage from '../../../layouts/ServicePage.astro';
import { ZONES } from '../../../data/entite.mjs';

const zones = ZONES.map((z) => (z === 'Montréal' ? 'Montreal' : z));

const faq = [
  {
    q: 'Which tasks can an aesthetic clinic automate?',
    a: 'Answering frequently asked questions, appointment booking, reminders, follow-ups for the next treatment and review requests after the visit.',
  },
  {
    q: 'Is health information protected?',
    a: "Health information is sensitive under Quebec's privacy law (Law 25). We automate the logistics (appointments, reminders) and keep clinical information out of AI tools, unless there is a documented need.",
  },
  {
    q: 'Does it work with my booking software?',
    a: 'Often, yes. We first check access to your software before promising anything.',
  },
];
---
<ServicePage
  lang="en"
  alt="/secteurs/cliniques-esthetique/"
  image="/images/secteurs/cliniques-esthetique.webp"
  imageAlt="The front desk of an aesthetic clinic"
  path="/en/industries/aesthetic-clinics"
  title="Automation for aesthetic and care clinics | FournIA"
  description="Bookings, appointment reminders, fewer no-shows and clients reminded about their next treatment: AI automation for aesthetic clinics in Quebec."
  h1="Automation for aesthetic and care clinics"
  lead="Missed appointments and clients who do not come back are expensive for a clinic. FournIA automates request replies, appointment reminders and follow-ups for the next treatment, while protecting your clients' information."
  serviceName="Aesthetic clinics"
  serviceType="Process automation for small businesses"
  areaServed={zones}
  faq={faq}
  updated="2026-11-18"
>
  <h2>What costs time</h2>
  <ul>
    <li>The same questions about prices and treatments, by message and by phone.</li>
    <li>Appointments missed without notice.</li>
    <li>Clients who never book their next treatment.</li>
    <li>Few Google reviews, despite satisfied clients.</li>
  </ul>

  <h2>What FournIA can automate</h2>
  <ul>
    <li>Answers to frequently asked questions, with appointment booking.</li>
    <li>Appointment reminders by text or email.</li>
    <li>A follow-up at the right time for the next treatment.</li>
    <li>A review request after the visit, starting with satisfied clients.</li>
  </ul>
  <p>You stay in control of decisions. The system prepares, you approve.</p>

  <h2>How it works</h2>
  <ol>
    <li><strong>A free 30-minute discovery call.</strong></li>
    <li><strong>An assessment</strong> of your process, from the request to delivery.</li>
    <li><strong>The build</strong> on your tools, one automation at a time.</li>
    <li><strong>Training</strong> for your team and follow-up.</li>
  </ol>
  <p>Every project that involves personal information goes through a review under Quebec's privacy law (<a href="/en/blog/law-25-ai-compliance-quebec-2026/">Law 25</a>). See also the <a href="/en/industries/">other industries</a>.</p>
</ServicePage>
