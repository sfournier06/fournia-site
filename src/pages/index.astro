<script is:inline>
  // nav : état au défilement
  const nav = document.getElementById('nav');
  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { nav.classList.toggle('scrolled', scrollY > 30); ticking = false; });
  }, { passive: true });

  // apparition au défilement (sections sous la ligne de flottaison)
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: .12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // démonstration interactive : le téléphone joue la scène (sans / avec le système), onglets, rejouer, lecture auto
  document.querySelectorAll('[data-demo]').forEach((demo) => {
    const DATA = JSON.parse(demo.querySelector('#demo-data').textContent);
    const tabs = [...demo.querySelectorAll('[role=tab]')];
    const fil = demo.querySelector('[data-fil]');
    const prog = demo.querySelector('[data-progres]');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0, mode = 'avec', timers = [], auto = true, vu = false;
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const later = (fn, ms) => timers.push(setTimeout(fn, ms));
    const esc = (t) => t.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    const add = (html) => { fil.insertAdjacentHTML('beforeend', html); fil.scrollTop = fil.scrollHeight; };

    function play() {
      clear();
      const sc = DATA[idx]; const evs = sc[mode];
      demo.dataset.mode = mode;
      demo.querySelectorAll('.bascule button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.mode === mode));
      demo.querySelector('[data-contact]').textContent = sc.contact;
      demo.querySelector('[data-canal]').textContent = sc.canal;
      demo.querySelector('.tel').classList.toggle('appel', Boolean(sc.voix) && mode === 'avec');
      demo.querySelector('[data-initiale]').textContent = sc.contact.replace(/[^A-Za-zÀ-ÿ0-9]/g, '').charAt(0);
      const pan = document.getElementById('pan-' + sc.id);
      pan.querySelectorAll('li').forEach((li) => li.classList.remove('on'));
      const res = pan.querySelector('.resultat'); res.classList.remove('vu');
      fil.innerHTML = ''; prog.style.width = '0%';
      const tab = tabs[idx]; tab.style.setProperty('--avance', '0%');
      let t = 300;
      evs.forEach((e, k) => {
        const typing = (e.who === 'in' || e.who === 'out') && !reduce;
        if (typing) {
          later(() => add(`<span class="ecrit ${e.who}" data-tmp><i></i><i></i><i></i></span>`), t);
          t += 900;
        }
        later(() => {
          fil.querySelector('[data-tmp]')?.remove();
          if (e.who === 'in' || e.who === 'out') add(`<p class="bulle ${e.who}">${e.lbl ? `<span class="qui">${esc(e.lbl)}</span>` : ''}${esc(e.txt)}<span class="h">${esc(e.t)}</span></p>`);
          else if (e.who === 'perte') add(`<p class="puce perte">${esc(e.txt)}</p>`);
          else add(`<p class="puce">${e.t ? `<b>${esc(e.t)}</b> · ` : ''}${esc(e.txt)}</p>`);
          if (e.step !== undefined) pan.querySelector(`li[data-step="${e.step}"]`)?.classList.add('on');
          const pct = Math.round(((k + 1) / evs.length) * 100) + '%';
          prog.style.width = pct; tab.style.setProperty('--avance', pct);
        }, t);
        t += reduce ? 0 : 1100;
      });
      later(() => {
        if (mode === 'avec') { res.classList.add('vu'); pan.querySelectorAll('li').forEach((li) => li.classList.add('on')); }
        if (auto) later(() => { if (mode === 'sans') { mode = 'avec'; play(); } else { select((idx + 1) % tabs.length); } }, 2600);
      }, t);
    }
    function select(i) {
      idx = i;
      tabs.forEach((x, j) => { const on = j === i; x.setAttribute('aria-selected', on); x.tabIndex = on ? 0 : -1;
        document.getElementById(x.getAttribute('aria-controls')).hidden = !on; x.style.setProperty('--avance', '0%'); });
      mode = auto ? 'sans' : mode;
      play();
    }
    const stopAuto = () => { auto = false; };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stopAuto(); mode = 'avec'; select(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault(); stopAuto(); const n = (i + d + tabs.length) % tabs.length; tabs[n].focus(); mode = 'avec'; select(n);
      });
    });
    demo.querySelectorAll('.bascule button').forEach((b) => b.addEventListener('click', () => { stopAuto(); mode = b.dataset.mode; play(); }));
    demo.querySelector('[data-rejouer]').addEventListener('click', () => { stopAuto(); play(); });
    // démarre quand la section devient visible ; pause quand elle sort
    new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting && !vu) { vu = true; mode = reduce ? 'avec' : 'sans'; if (reduce) auto = false; select(0); }
      else if (!e.isIntersecting && vu) { stopAuto(); }
    }), { threshold: .35 }).observe(demo);
  });

  // menu mobile
  const burger = document.getElementById('burger');
  burger.addEventListener('click', (e) => { e.stopPropagation(); const o = nav.classList.toggle('open'); burger.setAttribute('aria-expanded', o); });
  document.querySelectorAll('.nav-links a').forEach(a => a.addEventListener('click', () => nav.classList.remove('open')));
  document.addEventListener('click', (e) => { if (!nav.contains(e.target)) nav.classList.remove('open'); });
</script>
